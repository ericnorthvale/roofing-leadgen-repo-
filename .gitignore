# build
dist/
.output/
.vercel/
.turbo/
.vite/
.astro/

# deps
node_modules/
.pnp.*

# runtime generated
*.tsbuildinfo
# Responsive image siblings emitted by scripts/optimize-images.mjs on every
# build (pnpm run images). Generated from the committed originals, so they are
# build output, not source — keeping ~9MB of them in git would bloat every clone.
public/**/*-400.webp
public/**/*-800.webp
public/**/*-1200.webp

# test + coverage
coverage/
.nyc_output/
.lighthouseci/
playwright-report/
test-results/

# env + secrets
.env
.env.local
.env.*.local
!.env.example

# editor + os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.yarn/*
!.yarn/releases

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.swp
*.swo
