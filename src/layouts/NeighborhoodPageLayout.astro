---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CTAButton from "@components/CTAButton.astro";
import PhoneCTAButton from "@components/PhoneCTAButton.astro";
import LeadForm from "@components/LeadForm.astro";
import TrustBar from "@components/TrustBar.astro";
import Faq from "@components/Faq.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import ImagePlaceholder from "@components/ImagePlaceholder.astro";
import { buildSeo, faqPageJsonLd } from "~/lib/seo";
import { evaluateNeighborhood } from "~/lib/quality-gate";
import { SERVICE_AREAS } from "~/lib/service-areas";
import {
  cityServiceLinks,
  neighborhoodLinks,
  serviceLinks,
  cityHubLink,
} from "~/lib/internal-links";
import type { Neighborhood } from "~/lib/neighborhoods";

interface Props {
  neighborhood: Neighborhood;
}
const { neighborhood: n } = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://northvaleroofing.com";
const verdict = evaluateNeighborhood(n);
const city = SERVICE_AREAS[n.citySlug];

const jsonLd: Record<string, unknown>[] = [];
if (n.faqs && n.faqs.length > 0) jsonLd.push(faqPageJsonLd(n.faqs));

const seo = buildSeo(
  {
    title: n.seoTitle,
    description: n.seoDescription,
    pathname: `/${n.citySlug}/${n.slug}`,
    noindex: !verdict.indexable,
    jsonLd,
  },
  siteUrl,
);

const spokes = cityServiceLinks(n.citySlug);
const siblings = neighborhoodLinks(n.citySlug, n.slug);
const services = spokes.length > 0 ? [] : serviceLinks();
---

<BaseLayout seo={seo}>
  {
    !verdict.indexable && (
      <div class="border-b-2 border-[color:var(--color-gold-500)] bg-[color:var(--color-gold-50)] px-4 py-3 text-sm text-[color:var(--color-ink-800)]">
        <div class="mx-auto max-w-6xl">
          <strong>NEEDS REAL DATA — draft, not indexed.</strong> This page is <code>noindex</code>{" "}
          and excluded from the sitemap until a human adds real, distinct local content.
          {verdict.missing.length > 0 && <> Required: {verdict.missing.join("; ")}.</>}
        </div>
      </div>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: city.name, href: `/${city.slug}` },
        { label: n.name },
      ]}
    />
    <h1 class="mt-6 text-4xl md:text-5xl">Roofing in {n.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-ink-800)]">{n.intro}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <CTAButton href="/contact" label="Book inspection" ctaId={`nbhd-${n.slug}-book`} />
      <PhoneCTAButton ctaId={`nbhd-${n.slug}-call`} />
      <CTAButton href="/storm-response" variant="ghost" label="Storm today?" />
    </div>
  </section>

  <TrustBar />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[1fr_400px]">
    <article class="prose-northvale">
      <p>{n.localContext}</p>

      {
        n.developmentEra && (
          <Fragment>
            <h2>Roof age in {n.name}</h2>
            <p>{n.developmentEra}</p>
          </Fragment>
        )
      }

      {
        n.housingStock && (
          <Fragment>
            <h2>The homes — and the roofs — we see here</h2>
            <p>{n.housingStock}</p>
          </Fragment>
        )
      }

      {
        n.hoaNote && (
          <Fragment>
            <h2>Re-roof approvals in {n.name}</h2>
            <p>{n.hoaNote}</p>
          </Fragment>
        )
      }

      {
        n.landmarks && n.landmarks.length > 0 && (
          <Fragment>
            <h2>Around the village</h2>
            <ul>
              {n.landmarks.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
          </Fragment>
        )
      }

      {
        n.projects && n.projects.length > 0 && (
          <Fragment>
            <h2>Recent {n.name} projects</h2>
            <ul>
              {n.projects.map((p) => (
                <li>{p.summary}</li>
              ))}
            </ul>
          </Fragment>
        )
      }

      {
        n.testimonials && n.testimonials.length > 0 && (
          <Fragment>
            <h2>What {n.name} homeowners say</h2>
            {n.testimonials.map((t) => (
              <blockquote>
                <p>"{t.quote}"</p>
                <cite>
                  — {t.author}, via {t.source}
                </cite>
              </blockquote>
            ))}
          </Fragment>
        )
      }

      <slot />
    </article>
    <aside class="md:sticky md:top-10 md:self-start">
      <LeadForm source={`neighborhood:${n.slug}`} defaultCity={city.name} />
    </aside>
  </section>

  {
    verdict.indexable && (
      <section class="mx-auto max-w-6xl px-4 pb-4">
        <h2 class="text-2xl md:text-3xl">Our work near {n.name}</h2>
        <p class="mt-2 max-w-2xl text-sm text-[color:var(--color-ink-500)]">
          These slots fill with real photos from our own local jobs — never stock imagery.
        </p>
        <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
          <ImagePlaceholder
            slot={`NEIGHBORHOOD ${n.name}: completed roof`}
            alt={`Completed roof replacement in ${n.name}, The Woodlands`}
            demoKey="work-1"
            ratio="1/1"
            tone="mixed"
          />
          <ImagePlaceholder
            slot={`NEIGHBORHOOD ${n.name}: crew at work`}
            alt={`Northvale Roofing crew working in ${n.name}`}
            demoKey="work-2"
            ratio="1/1"
            tone="navy"
          />
          <ImagePlaceholder
            slot={`NEIGHBORHOOD ${n.name}: roof detail`}
            alt={`Roofing detail from a ${n.name} project`}
            demoKey="work-3"
            ratio="1/1"
            tone="gold"
          />
          <ImagePlaceholder
            slot={`NEIGHBORHOOD ${n.name}: finished roofline`}
            alt={`Finished roofline on a home in ${n.name}`}
            demoKey="work-4"
            ratio="1/1"
            tone="navy"
          />
        </div>
      </section>
    )
  }

  {n.faqs && n.faqs.length > 0 && <Faq items={n.faqs} heading={`${n.name} roofing questions`} />}

  {
    spokes.length > 0 ? (
      <RelatedLinks heading={`Our services in ${city.name}`} links={spokes} />
    ) : (
      <RelatedLinks heading="Our roofing services" links={services} />
    )
  }
  {
    siblings.length > 0 && (
      <RelatedLinks
        heading={`More ${city.name} villages we serve`}
        links={[cityHubLink(n.citySlug), ...siblings]}
      />
    )
  }
</BaseLayout>
