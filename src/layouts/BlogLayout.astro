---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import CTAButton from "@components/CTAButton.astro";
import { BRAND } from "~/lib/brand";
import { blogPostingJsonLd } from "~/lib/seo";
import { findAuthor } from "~/lib/authors";
import RoofImage from "@components/RoofImage.astro";
import type { SeoInput } from "~/lib/seo";
import type { LinkItem } from "~/lib/internal-links";

interface Props {
  seo: SeoInput;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  /** Related service/city pages, resolved by the caller from the post's cluster. */
  related?: LinkItem[];
}
const { seo, title, description, pubDate, updatedDate, author, related = [] } = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://northvaleroofing.com";
const person = findAuthor(author);
const posting = blogPostingJsonLd(siteUrl, {
  title,
  description,
  pathname: seo.pathname ?? "/blog",
  datePublished: pubDate,
  dateModified: updatedDate,
  authorName: author,
  // The default byline is the company; a named human author gets Person schema
  // with a url and photo, so the byline resolves to someone who exists.
  authorType: person ? "Person" : "Organization",
  ...(person ? { authorUrl: person.url, authorImage: person.image } : {}),
  image: seo.ogImage,
});
const jsonLd = [
  ...(Array.isArray(seo.jsonLd) ? seo.jsonLd : seo.jsonLd ? [seo.jsonLd] : []),
  posting,
];
---

<BaseLayout seo={{ ...seo, jsonLd }}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs
      items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: title }]}
    />
    <header class="mt-6">
      <h1 class="text-4xl leading-tight md:text-5xl">{title}</h1>
      <div class="rule-gold mt-5" aria-hidden="true"></div>
      <p class="mt-3 text-lg text-[color:var(--color-ink-500)]">{description}</p>
      <p class="mt-3 text-sm text-[color:var(--color-ink-500)]">
        By {
          person ? (
            <a class="font-semibold text-[color:var(--color-navy-800)]" href={person.url}>
              {person.name}
            </a>
          ) : (
            author
          )
        }{person ? `, ${person.role.replace(/^Owner, .*/, "Owner")}` : ""} · Published <time
          datetime={pubDate.toISOString()}
          >{
            pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
          }</time
        >
        {
          updatedDate && (
            <>
              {" "}
              · Updated{" "}
              <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </>
          )
        }
      </p>
    </header>
    <section class="prose-northvale mt-8"><slot /></section>

    <footer class="mt-12 rounded-lg border border-[color:var(--color-ink-100)] p-6">
      {
        person ? (
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
            {person.image && (
              <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full">
                <RoofImage
                  src={person.image}
                  alt={`${person.name}, ${person.role}`}
                  sizes="80px"
                  class="block h-full w-full object-cover"
                />
              </div>
            )}
            <div>
              <p class="text-sm font-semibold tracking-wide text-[color:var(--color-ink-500)] uppercase">
                Written by
              </p>
              <p class="mt-1">
                <a class="text-lg font-semibold no-underline" href={person.url}>
                  {person.name}
                </a>
                <span class="text-sm text-[color:var(--color-ink-500)]"> · {person.role}</span>
              </p>
              <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">{person.bio}</p>
              <div class="mt-4">
                <CTAButton
                  href="/contact"
                  label="Book a free inspection"
                  ctaId="blog-author-box-book"
                />
              </div>
            </div>
          </div>
        ) : (
          <Fragment>
            <p class="text-sm font-semibold tracking-wide text-[color:var(--color-ink-500)] uppercase">
              About {BRAND.name}
            </p>
            <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">
              {BRAND.name} is a residential roofing company serving The Woodlands and the north
              Houston metro — roof replacement, repair, inspections, and storm-damage documentation.
              Same-day inspection, written estimate before we leave the driveway.
            </p>
            <div class="mt-4">
              <CTAButton
                href="/contact"
                label="Book a free inspection"
                ctaId="blog-author-box-book"
              />
            </div>
          </Fragment>
        )
      }
    </footer>
  </article>

  {related.length > 0 && <RelatedLinks heading="Keep reading" links={related} />}
</BaseLayout>
