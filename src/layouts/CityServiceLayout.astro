---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CTAButton from "@components/CTAButton.astro";
import PhoneCTAButton from "@components/PhoneCTAButton.astro";
import LeadForm from "@components/LeadForm.astro";
import TrustBar from "@components/TrustBar.astro";
import Faq from "@components/Faq.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import TableOfContents from "@components/TableOfContents.astro";
import BeforeAfter from "@components/BeforeAfter.astro";
import { buildSeo, faqPageJsonLd } from "~/lib/seo";
import { evaluateCityService } from "~/lib/quality-gate";
import { SERVICE_AREAS } from "~/lib/service-areas";
import { SERVICES } from "~/lib/services";
import { headingId } from "~/lib/headings";
import { cityServiceLinks, neighborhoodLinks, cityHubLink } from "~/lib/internal-links";
import type { CityService } from "~/lib/city-services";

interface Props {
  cityService: CityService;
}
const { cityService: cs } = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://northvaleroofing.com";
const base = siteUrl.replace(/\/+$/, "");
const verdict = evaluateCityService(cs);
const city = SERVICE_AREAS[cs.citySlug];
const genericService = SERVICES[cs.serviceTag];

// Service schema scoped to THIS city (unlike the generic service pages, which
// carry the full areaServed list).
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: cs.title,
    description: cs.seoDescription,
    url: `${base}/${cs.citySlug}/${cs.slug}`,
    provider: { "@id": `${base}#business` },
    areaServed: { "@type": "City", name: `${city.name}, TX` },
  },
];
if (cs.faqs && cs.faqs.length > 0) jsonLd.push(faqPageJsonLd(cs.faqs));

const seo = buildSeo(
  {
    title: cs.seoTitle,
    description: cs.seoDescription,
    pathname: `/${cs.citySlug}/${cs.slug}`,
    noindex: !verdict.indexable,
    jsonLd,
  },
  siteUrl,
);

const toc = [
  ...cs.sections.map((s) => ({ id: headingId(s.heading), label: s.heading })),
  ...(cs.faqs && cs.faqs.length > 0
    ? [{ id: "faq", label: `${city.name} questions, answered` }]
    : []),
];

const siblingSpokes = cityServiceLinks(cs.citySlug, cs.slug);
const villages = neighborhoodLinks(cs.citySlug);
---

<BaseLayout seo={seo}>
  {
    !verdict.indexable && (
      <div class="border-b-2 border-[color:var(--color-gold-400)] bg-[color:var(--color-gold-50)] px-4 py-3 text-sm text-[color:var(--color-ink-800)]">
        <div class="mx-auto max-w-6xl">
          <strong>NEEDS REAL DATA — draft, not indexed.</strong> This page is <code>noindex</code>{" "}
          and excluded from the sitemap until it carries real, locally-specific content.
          {verdict.missing.length > 0 && <> Required: {verdict.missing.join("; ")}.</>}
        </div>
      </div>
    )
  }

  {
    cs.heroPhoto ? (
      /* Photo header: real work photo under the brand scrim (owner-approved
         service-page visual system). Same words as the classic band. */
      <section class="relative overflow-hidden bg-[color:var(--color-navy-950)]">
        <img
          src={cs.heroPhoto.src}
          alt={cs.heroPhoto.alt}
          class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="nv-svc-scrim absolute inset-0" aria-hidden="true" />
        <div class="relative mx-auto max-w-6xl px-4 py-14 md:py-20">
          <Breadcrumbs
            variant="dark"
            items={[
              { label: "Home", href: "/" },
              { label: city.name, href: `/${city.slug}` },
              { label: genericService.title },
            ]}
          />
          <h1 class="mt-6 max-w-3xl text-4xl text-white md:text-5xl">{cs.title}</h1>
          <div class="rule-gold mt-6" aria-hidden="true" />
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-navy-100)]">
            {cs.summary}
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <CTAButton
              href="/contact"
              label="Book inspection"
              ctaId={`cs-${cs.citySlug}-${cs.serviceTag}-book`}
            />
            <PhoneCTAButton
              ctaId={`cs-${cs.citySlug}-${cs.serviceTag}-call`}
              variant="ghost-dark"
            />
            <CTAButton href="/storm-response" variant="ghost-dark" label="Storm today?" />
          </div>
          {cs.glance && cs.glance.length > 0 && (
            <ul class="mt-9 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/15 pt-6">
              {cs.glance.map((g) => (
                <li class="flex items-baseline gap-2.5">
                  <span class="font-serif text-[28px] leading-none text-[color:var(--color-gold-300)]">
                    {g.value}
                  </span>
                  <span class="max-w-52 text-[13px] leading-snug text-[color:var(--color-navy-100)]/90">
                    {g.label}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ) : (
      <section class="page-header-band mx-auto max-w-6xl px-4 py-12 md:py-16">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: city.name, href: `/${city.slug}` },
            { label: genericService.title },
          ]}
        />
        <h1 class="mt-6 text-4xl md:text-5xl">{cs.title}</h1>
        <div class="rule-gold mt-6" aria-hidden="true" />
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-700)]">
          {cs.summary}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <CTAButton
            href="/contact"
            label="Book inspection"
            ctaId={`cs-${cs.citySlug}-${cs.serviceTag}-book`}
          />
          <PhoneCTAButton ctaId={`cs-${cs.citySlug}-${cs.serviceTag}-call`} />
          <CTAButton href="/storm-response" variant="ghost" label="Storm today?" />
        </div>
      </section>
    )
  }

  <TrustBar />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-10 md:grid-cols-[1fr_400px]">
    <article class="prose-northvale">
      <TableOfContents items={toc} />
      {
        cs.sections.map((section) => (
          <Fragment>
            <h2 id={headingId(section.heading)}>{section.heading}</h2>
            {section.body && <p>{section.body}</p>}
            {section.bullets && section.kind === "steps" ? (
              /* Numbered gold timeline — same <ol> text, styled. */
              <ol class="nv-steplist">
                {section.bullets.map((b, i) => (
                  <li class="relative flex gap-4 pb-6 pl-1 last:pb-2">
                    <span
                      class="z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-gold-400)] bg-white font-serif text-[28px] leading-none text-[color:var(--color-gold-600)]"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <span class="pt-1.5 text-[15px] leading-relaxed text-[color:var(--color-ink-800)]">
                      {b.lead && <strong>{b.lead}</strong>}
                      {b.lead && b.text ? " — " : ""}
                      {b.text}
                    </span>
                  </li>
                ))}
              </ol>
            ) : section.bullets && section.kind === "cards" ? (
              /* Card grid — bullet lead becomes the card title. */
              <ul class="nv-cardlist grid gap-4 sm:grid-cols-2">
                {section.bullets.map((b) => (
                  <li class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5">
                    {b.lead && (
                      <strong class="block text-base text-[color:var(--color-navy-900)]">
                        {b.lead}
                      </strong>
                    )}
                    <span class="mt-1.5 block text-sm leading-relaxed text-[color:var(--color-ink-700)]">
                      {b.text}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              section.bullets &&
              (section.ordered ? (
                <ol>
                  {section.bullets.map((b) =>
                    b.html ? (
                      <li set:html={b.html} />
                    ) : (
                      <li>
                        {b.lead && <strong>{b.lead}</strong>}
                        {b.lead && b.text ? " — " : ""}
                        {b.text}
                      </li>
                    ),
                  )}
                </ol>
              ) : (
                <ul>
                  {section.bullets.map((b) =>
                    b.html ? (
                      <li set:html={b.html} />
                    ) : (
                      <li>
                        {b.lead && <strong>{b.lead}</strong>}
                        {b.lead && b.text ? " — " : ""}
                        {b.text}
                      </li>
                    ),
                  )}
                </ul>
              ))
            )}
            {section.photo && (
              /* Real work photo inset (never stock — Hard Rule #2). */
              <figure class="my-8">
                <div
                  class="overflow-hidden rounded-[var(--radius-card)]"
                  style="aspect-ratio:16/9;"
                >
                  <img
                    src={section.photo.src}
                    alt={section.photo.alt}
                    loading="lazy"
                    decoding="async"
                    class="block h-full w-full object-cover"
                  />
                </div>
                {section.photo.caption && (
                  <figcaption class="mt-2.5 text-xs font-semibold tracking-[0.12em] text-[color:var(--color-ink-500)] uppercase">
                    {section.photo.caption}
                  </figcaption>
                )}
              </figure>
            )}
          </Fragment>
        ))
      }
      <p>
        Looking for how we handle this service everywhere we work? See the full{" "}
        <a href={`/services/${genericService.slug}`}>{genericService.title.toLowerCase()}</a> guide.
      </p>
    </article>
    <aside class="md:sticky md:top-10 md:self-start">
      <LeadForm
        source={`city-service:${cs.citySlug}:${cs.serviceTag}`}
        defaultCity={city.name}
        defaultService={cs.serviceTag}
      />
    </aside>
  </section>

  {
    cs.beforeAfter && (
      <BeforeAfter
        heading="See the difference"
        intro={cs.beforeAfter.intro}
        beforeSrc={cs.beforeAfter.beforeSrc}
        beforeAlt={cs.beforeAfter.beforeAlt}
        beforeCaption={cs.beforeAfter.beforeCaption}
        afterSrc={cs.beforeAfter.afterSrc}
        afterAlt={cs.beforeAfter.afterAlt}
        afterCaption={cs.beforeAfter.afterCaption}
      />
    )
  }

  {
    cs.faqs && cs.faqs.length > 0 && (
      <div id="faq">
        <Faq items={cs.faqs} heading={`${city.name} questions, answered`} accordion={true} />
      </div>
    )
  }

  {
    siblingSpokes.length > 0 && (
      <RelatedLinks
        heading={`More of our work in ${city.name}`}
        links={[cityHubLink(cs.citySlug), ...siblingSpokes]}
      />
    )
  }
  {villages.length > 0 && <RelatedLinks heading="Villages we serve" links={villages} />}
</BaseLayout>

<style is:global>
  /* Scrim for the photo header: readable copy left, photo visible right. */
  .nv-svc-scrim {
    background: linear-gradient(
      to bottom,
      rgb(6 14 33 / 0.94) 0%,
      rgb(6 14 33 / 0.86) 60%,
      rgb(6 14 33 / 0.72) 100%
    );
  }
  @media (min-width: 768px) {
    .nv-svc-scrim {
      background: linear-gradient(
        to right,
        rgb(6 14 33 / 0.96) 0%,
        rgb(6 14 33 / 0.9) 45%,
        rgb(6 14 33 / 0.55) 75%,
        rgb(6 14 33 / 0.25) 100%
      );
    }
  }
  /* The steps timeline + card grid opt out of prose list styling (the
     .prose-northvale ol/ul rules would otherwise re-add markers/padding). */
  .prose-northvale ol.nv-steplist {
    list-style: none;
    padding-left: 0;
    margin: 1.25rem 0 1.5rem;
  }
  .prose-northvale ul.nv-cardlist {
    list-style: none;
    padding-left: 0;
    margin: 1.25rem 0 1.5rem;
  }
  /* Vertical connector between step numbers. */
  .nv-steplist li:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2.4rem;
    left: 1.35rem;
    bottom: 0.2rem;
    width: 1px;
    background: var(--color-gold-400);
    opacity: 0.45;
  }
</style>
