---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CTAButton from "@components/CTAButton.astro";
import PhoneCTAButton from "@components/PhoneCTAButton.astro";
import LeadForm from "@components/LeadForm.astro";
import TrustBar from "@components/TrustBar.astro";
import Faq from "@components/Faq.astro";
import { faqPageJsonLd } from "~/lib/seo";

/**
 * Roof size calculator — measurement only, deliberately NO pricing (owner,
 * 2026-08-11). Auto mode reads Google's Solar API through our server proxy
 * (/api/roof-measure) so the key stays private; where aerial data is missing
 * the visitor traces the roof on the satellite map instead (honest pitch
 * multipliers, no hidden "waste" inflation). A finished measurement prefill's
 * the lead form's address + notes — that's the lead hook: the exact number
 * comes from the free written estimate, never from a satellite guess.
 *
 * Key handling (owner decision 2026-08-11, "run it like Wix — no Vercel"):
 * the browser key below is Northvale's own PUBLIC map key, committed on
 * purpose. It is safe to ship ONLY because it is (a) public-by-design — it
 * ships in the page HTML on every load regardless — and (b) locked in the
 * Google console to this site's domains and to the Maps JS / Places / Solar
 * APIs, with quota caps. NEVER commit a server/secret key this way. A
 * PUBLIC_GOOGLE_MAPS_BROWSER_KEY env var, if ever set in Vercel, overrides it.
 */

const mapsKey =
  (import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? "").trim() ||
  "AIzaSyBjYX0eqE0U1oMRtoQoSaTRxgab-S4zQFI";

const FAQS = [
  {
    q: "What is a roofing “square”?",
    a: "One square is 100 square feet of roof surface — the unit every roofer prices and orders materials by. A roof with 2,300 square feet of surface is a 23-square roof. Note that roof surface is bigger than the house's floor plan, because slopes add area.",
  },
  {
    q: "How accurate is a satellite measurement?",
    a: "Good, not gospel. Google's aerial data measures each roof plane and its slope, and on most established homes it lands close. It gets less reliable under heavy tree cover, on brand-new construction the imagery hasn't caught up with, and on complex rooflines. That's why we verify every measurement on-site before a contract price — the tool is for orientation, not for signing.",
  },
  {
    q: "Why doesn't this show a price?",
    a: "Because size is only one input. Pitch and access, layers to tear off, decking condition, flashing details, and the material you choose all move the real number. A tool that turns a satellite guess into a dollar figure is guessing twice. We'd rather measure it properly for free and put the exact price in writing before we leave your driveway.",
  },
  {
    q: "Do you save my address?",
    a: "No. The lookup runs against Google's mapping data and we don't store what you type unless you choose to send the contact form. Your measurement stays on your screen.",
  },
];

const seo = {
  title: "Roof Size Calculator — Measure Your Roof by Address",
  description:
    "Type your address and see your roof's size in seconds — squares, square footage, and pitch from aerial imagery, or trace it yourself on the satellite map. Free written estimate for the exact number.",
  pathname: "/roof-size-calculator",
  jsonLd: [faqPageJsonLd(FAQS)],
};
---

<BaseLayout seo={seo}>
  <section class="page-header-band mx-auto max-w-6xl px-4 py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Roof size calculator" }]} />
    <h1 class="mt-6 text-4xl md:text-5xl">How big is your roof?</h1>
    <div class="rule-gold mt-6" aria-hidden="true"></div>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-700)]">
      Type your address and get your roof's size in seconds — measured plane by plane from aerial
      imagery, or traced by you on the satellite map. Size only, no price games: the exact number
      comes free, in writing, from a real inspection.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <CTAButton href="/contact" label="Get the exact number free" ctaId="rooftool-book" />
      <PhoneCTAButton ctaId="rooftool-call" />
    </div>
  </section>

  <TrustBar />

  {
    (
      <section class="border-y border-[color:var(--color-navy-100)] bg-[color:var(--color-surface-ivory)]">
        <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
          <div id="nv-rooftool" data-key={mapsKey} class="grid gap-8 lg:grid-cols-[1fr_380px]">
            {/* Map + controls */}
            <div>
              <label
                for="rt-address"
                class="text-sm font-semibold text-[color:var(--color-navy-900)]"
              >
                Your address
              </label>
              <div
                id="rt-pac"
                class="mt-2 rounded-full border border-[color:var(--color-navy-100)] bg-white px-3 py-1.5 shadow-sm transition-[border-color,box-shadow] focus-within:border-[color:var(--color-gold-400)] focus-within:shadow-[0_0_0_3px_rgb(201_162_108/0.22)] [&_input]:text-base"
              >
                {/* PlaceAutocompleteElement mounts here; plain input until then. */}
                <input
                  id="rt-address"
                  type="text"
                  placeholder="123 Main St, Spring, TX"
                  class="w-full rounded-lg border-0 px-3 py-2 text-base text-[color:var(--color-ink-800)] outline-none"
                />
              </div>
              <p
                id="rt-status"
                class="mt-2.5 min-h-5 text-sm text-[color:var(--color-ink-600)]"
                aria-live="polite"
              >
                Start typing and pick your address — we'll find your roof.
              </p>
              <div
                id="rt-map"
                class="mt-4 h-[380px] w-full overflow-hidden rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] md:h-[440px]"
              />
              {/* Shown once a roof is highlighted: the measured building is
                  only trustworthy if a human confirms it's the right one. */}
              <p
                id="rt-verify"
                class="mt-3 hidden rounded-lg bg-[color:var(--color-gold-50)] px-3 py-2 text-sm text-[color:var(--color-ink-800)]"
              >
                <strong>Is the gold box around your house?</strong> If it's around a garage, a shed
                or next door, just tap your own house on the map and we'll measure that instead.
              </p>

              <button
                id="rt-bigger"
                type="button"
                class="mt-2 hidden w-full rounded-lg border-2 border-[color:var(--color-gold-400)] bg-white px-3 py-2.5 text-left text-sm text-[color:var(--color-ink-800)] hover:bg-[color:var(--color-gold-50)]"
              >
                <strong class="text-[color:var(--color-navy-900)]">
                  Bigger building next to this one.
                </strong>
                <span id="rt-bigger-msg" />
              </button>

              <div class="mt-4 flex flex-wrap items-center gap-2.5">
                <button
                  id="rt-draw"
                  type="button"
                  class="rounded-full border border-[color:var(--color-navy-100)] bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:border-[color:var(--color-gold-400)] hover:text-[color:var(--color-gold-600)]"
                >
                  ✏️ Trace it myself
                </button>
                <button
                  id="rt-reset"
                  type="button"
                  class="rounded-full border border-[color:var(--color-navy-100)] bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:border-[color:var(--color-gold-400)] hover:text-[color:var(--color-gold-600)]"
                >
                  Start over
                </button>
                <button
                  id="rt-undo"
                  type="button"
                  class="rt-tracebtn hidden rounded-full border border-[color:var(--color-navy-100)] bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:border-[color:var(--color-gold-400)] hover:text-[color:var(--color-gold-600)]"
                >
                  Undo corner
                </button>
                <button
                  id="rt-newsection"
                  type="button"
                  class="rt-tracebtn hidden rounded-full border border-[color:var(--color-navy-100)] bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:border-[color:var(--color-gold-400)] hover:text-[color:var(--color-gold-600)]"
                >
                  New roof section
                </button>
                <button
                  id="rt-clear"
                  type="button"
                  class="rt-tracebtn hidden rounded-full border border-[color:var(--color-navy-100)] bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:border-[color:var(--color-gold-400)] hover:text-[color:var(--color-gold-600)]"
                >
                  Clear outline
                </button>
                <div id="rt-pitch" class="hidden flex-wrap items-center gap-2" data-mult="1.118">
                  <span class="text-xs text-[color:var(--color-ink-600)]">Roof steepness:</span>
                  <button
                    type="button"
                    data-mult="1.054"
                    class="rt-pitch-btn rounded-full border border-[color:var(--color-navy-100)] bg-white px-3 py-1.5 text-xs font-semibold text-[color:var(--color-navy-900)]"
                  >
                    Low (4/12)
                  </button>
                  <button
                    type="button"
                    data-mult="1.118"
                    class="rt-pitch-btn rt-pitch-active rounded-full border border-[color:var(--color-navy-100)] bg-white px-3 py-1.5 text-xs font-semibold text-[color:var(--color-navy-900)]"
                  >
                    Average (6/12)
                  </button>
                  <button
                    type="button"
                    data-mult="1.25"
                    class="rt-pitch-btn rounded-full border border-[color:var(--color-navy-100)] bg-white px-3 py-1.5 text-xs font-semibold text-[color:var(--color-navy-900)]"
                  >
                    Steep (9/12)
                  </button>
                  <button
                    type="button"
                    data-mult="1.414"
                    class="rt-pitch-btn rounded-full border border-[color:var(--color-navy-100)] bg-white px-3 py-1.5 text-xs font-semibold text-[color:var(--color-navy-900)]"
                  >
                    Very steep (12/12)
                  </button>
                </div>
              </div>
            </div>

            {/* Results */}
            <div
              class="self-start rounded-2xl border border-[color:var(--color-navy-100)] bg-white p-6 shadow-sm md:p-7"
              aria-live="polite"
            >
              {/* Cover photo for the PDF, shown here first so what you
                  download is never a surprise. Hidden unless it loads. */}
              <figure id="rt-photo-wrap" class="mb-5 hidden">
                <img
                  id="rt-photo"
                  alt="Aerial view of the measured property"
                  class="block w-full rounded-xl border border-[color:var(--color-navy-100)]"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="mt-1.5 text-[11px] text-[color:var(--color-ink-500)]">
                  Aerial imagery: USGS The National Map (public domain)
                </figcaption>
              </figure>

              <p class="text-xs font-semibold tracking-[0.14em] text-[color:var(--color-ink-500)] uppercase">
                Your roof measures
              </p>
              <p class="mt-2">
                <span
                  id="rt-squares"
                  class="font-serif text-5xl text-[color:var(--color-gold-600)]"
                >
                  —
                </span>
                <span class="text-lg text-[color:var(--color-ink-500)]"> squares measured</span>
              </p>
              {/* The with-waste figure is what other estimators headline, so
                  show it with equal weight rather than burying it. */}
              <p class="mt-2.5 flex items-baseline gap-2">
                <span id="rt-order" class="font-serif text-3xl text-[color:var(--color-navy-900)]">
                  —
                </span>
                <span id="rt-order-note" class="text-sm text-[color:var(--color-ink-500)]">
                  squares to order
                </span>
              </p>
              <dl class="mt-6 space-y-3 border-t border-[color:var(--color-navy-100)] pt-5 text-sm">
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-[color:var(--color-ink-500)]">Roof surface</dt>
                  <dd id="rt-surface" class="font-semibold text-[color:var(--color-navy-900)]">
                    —
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-[color:var(--color-ink-500)]">Building footprint</dt>
                  <dd id="rt-footprint" class="font-semibold text-[color:var(--color-navy-900)]">
                    —
                  </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-[color:var(--color-ink-500)]">Average pitch</dt>
                  <dd id="rt-pitchout" class="font-semibold text-[color:var(--color-navy-900)]">
                    —
                  </dd>
                </div>
              </dl>
              <p
                id="rt-meta"
                class="mt-4 min-h-4 text-xs leading-relaxed text-[color:var(--color-ink-500)]"
              />

              {/* Shown instead of numbers when canopy/imagery makes the
                  measurement untrustworthy — we block rather than guess. */}
              <div
                id="rt-blocked"
                class="mt-4 hidden rounded-xl border border-[color:var(--color-gold-400)] bg-[color:var(--color-gold-50)] p-4"
              >
                <p class="text-sm font-semibold text-[color:var(--color-navy-900)]">
                  We can't measure this one from the air
                </p>
                <p
                  id="rt-blocked-msg"
                  class="mt-1.5 text-xs leading-relaxed text-[color:var(--color-ink-700)]"
                />
              </div>

              <button
                id="rt-download"
                type="button"
                disabled
                class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full border border-[color:var(--color-navy-900)] px-5 py-3 text-sm font-bold text-[color:var(--color-navy-900)] transition-colors hover:bg-[color:var(--color-navy-900)] hover:text-white disabled:cursor-not-allowed disabled:border-[color:var(--color-navy-100)] disabled:text-[color:var(--color-ink-500)] disabled:hover:bg-transparent disabled:hover:text-[color:var(--color-ink-500)]"
              >
                <span id="rt-download-label">Download measurement report (PDF)</span>
              </button>

              <a
                href="#roof-lead"
                class="mt-3 inline-flex w-full items-center justify-center rounded-full bg-[color:var(--color-gold-400)] px-5 py-3 text-sm font-bold text-[color:var(--color-navy-950)] transition-colors hover:bg-[color:var(--color-gold-300)]"
              >
                Get the exact number, free & in writing
              </a>
              <p class="mt-3 text-xs leading-relaxed text-[color:var(--color-ink-500)]">
                A satellite estimate is for orientation. Aerial models tend to clip eaves and smooth
                the steepest slopes, so they read a little under a full measurement — and trees, new
                construction and complex rooflines all affect them. We measure on-site before any
                contract price.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[1fr_400px]">
    <article class="prose-northvale">
      <h2>What the numbers mean</h2>
      <p>
        Roofers measure in <strong>squares</strong> — one square is 100 square feet of roof surface. Your
        roof's surface is larger than your home's floor plan, because slope adds area: the steeper the
        pitch, the more roof sits over the same footprint. When aerial data is available we measure every
        roof plane and its own slope; when it isn't, you trace the building outline and pick a steepness,
        and we do the honest math from there.
      </p>
      <h2>Why we stop at size</h2>
      <p>
        Plenty of tools convert a satellite guess straight into a dollar figure. We don't, on
        purpose. The real price of a roof depends on things no satellite can see — how many layers
        come off, what the decking looks like underneath, flashing details, access, and the material
        you choose. Size is the honest half of the answer; the other half is a free inspection and
        an exact price in writing before we leave the driveway.
      </p>
    </article>
    <aside id="roof-lead" class="scroll-mt-24 md:sticky md:top-10 md:self-start">
      <LeadForm source="roof-size-tool" />
    </aside>
  </section>

  <div id="faq">
    <Faq items={FAQS} heading="Roof measuring, answered" accordion={true} />
  </div>
</BaseLayout>

<style is:global>
  .rt-pitch-active {
    background: var(--color-gold-400);
    border-color: var(--color-gold-400) !important;
    color: var(--color-navy-950) !important;
  }
  /* The Google autocomplete web component fills its white pill shell.
     color-scheme + the gmp-mat tokens pin it to our light palette even when
     the visitor's device is in dark mode (otherwise it paints itself black). */
  #rt-pac gmp-place-autocomplete {
    display: block;
    width: 100%;
    color-scheme: light;
    font-family: inherit;
    --gmp-mat-color-surface: #ffffff;
    --gmp-mat-color-on-surface: var(--color-ink-800);
    --gmp-mat-color-on-surface-variant: var(--color-ink-500);
    --gmp-mat-color-primary: var(--color-gold-600);
    --gmp-mat-color-outline: transparent;
    --gmp-mat-color-outline-variant: var(--color-navy-100);
    background: #ffffff;
  }
</style>

<script>
  /**
   * Roof measuring tool.
   *
   * Auto mode: address → lat/lng → Google's Solar API (browser-direct with the
   * site's domain-locked public key), reduced to the shared RoofSummary so the
   * screen and the PDF can never disagree. Manual mode: tap the roof's corners;
   * traced area × the chosen slope multiplier (real geometry, sec(pitch) — no
   * hidden "waste" padding in the measurement itself).
   *
   * A measurement that fails the confidence gate (heavy canopy, poor imagery,
   * planes that don't add up) shows NO number at all — see lib/roof-report.ts.
   * Nothing typed here is stored server-side.
   */
  import {
    buildRoofSummary,
    pitchLabel as fmtPitch,
    pitchRangeLabel,
    formatImageryDate,
    type RoofPlane,
    type RoofSummary,
  } from "~/lib/roof-report";

  const root = document.getElementById("nv-rooftool");
  const KEY = root?.dataset.key ?? "";

  if (root && KEY) {
    const el = (id: string) => document.getElementById(id)!;
    const status = el("rt-status");
    const setStatus = (t: string) => (status.textContent = t);
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");

    const state = {
      mode: "auto" as "auto" | "manual",
      address: "",
      polygons: [] as any[],
      pitchMult: 1.118,
      /** Last publishable measurement — drives the panel, form and PDF alike. */
      summary: null as RoofSummary | null,
      method: "aerial" as "aerial" | "manual",
      center: null as { lat: number; lng: number } | null,
    };

    function loadMaps(key: string): Promise<any> {
      return new Promise((resolve, reject) => {
        const w = window as any;
        if (w.google?.maps?.importLibrary) return resolve(w.google);
        w.__nvMapsReady = () => resolve(w.google);
        const s = document.createElement("script");
        s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&v=weekly&loading=async&callback=__nvMapsReady`;
        s.async = true;
        s.onerror = () => reject(new Error("Google Maps failed to load"));
        document.head.appendChild(s);
      });
    }

    const blockedBox = el("rt-blocked");
    const downloadBtn = el("rt-download") as HTMLButtonElement;

    function showBlocked(message: string) {
      blockedBox.classList.remove("hidden");
      el("rt-blocked-msg").textContent = message;
    }
    function hideBlocked() {
      blockedBox.classList.add("hidden");
    }

    const photoWrap = el("rt-photo-wrap");
    const photoImg = el("rt-photo") as HTMLImageElement;
    /** Load the report's cover photo; stay hidden if there's no coverage. */
    function showPropertyPhoto() {
      if (!state.center) return;
      const src = `/api/property-image?lat=${state.center.lat}&lng=${state.center.lng}`;
      if (photoImg.getAttribute("src") === src) return;
      photoImg.onload = () => photoWrap.classList.remove("hidden");
      photoImg.onerror = () => photoWrap.classList.add("hidden");
      photoWrap.classList.add("hidden");
      photoImg.src = src;
    }
    function hidePropertyPhoto() {
      photoWrap.classList.add("hidden");
      photoImg.removeAttribute("src");
    }

    /**
     * Single render path for both modes. A blocked verdict clears the figures
     * entirely — we show nothing rather than a number we don't trust.
     */
    function applySummary(summary: RoofSummary | null, method: "aerial" | "manual") {
      state.method = method;

      if (!summary || summary.confidence.level === "blocked") {
        state.summary = null;
        el("rt-squares").textContent = "—";
        el("rt-order").textContent = "—";
        el("rt-order-note").textContent = "squares to order";
        el("rt-surface").textContent = "—";
        el("rt-footprint").textContent = "—";
        el("rt-pitchout").textContent = "—";
        el("rt-meta").textContent = "";
        downloadBtn.disabled = true;
        hidePropertyPhoto();
        if (summary) showBlocked(summary.confidence.message);
        else hideBlocked();
        return;
      }

      hideBlocked();
      state.summary = summary;
      showPropertyPhoto();
      el("rt-squares").textContent = summary.squares.toFixed(1);
      el("rt-order").textContent = summary.squaresWithWaste.toFixed(1);
      el("rt-order-note").textContent = `squares to order (incl. ${summary.waste.percent}% waste)`;
      el("rt-surface").textContent = `${fmt(summary.surfaceFt2)} ft²`;
      el("rt-footprint").textContent = `${fmt(summary.footprintFt2)} ft²`;
      el("rt-pitchout").textContent = pitchRangeLabel(summary.pitchRangeDeg);

      const imagery = formatImageryDate(summary.imageryDate);
      const parts: string[] = [];
      if (method === "aerial") {
        parts.push(
          `Measured across ${summary.planes.length} roof plane${summary.planes.length === 1 ? "" : "s"}.`,
        );
        if (imagery) parts.push(`Imagery ${imagery}.`);
      } else {
        parts.push("Traced by you — drag the dots to fine-tune.");
      }
      parts.push(
        `Waste allowance ${summary.waste.percent}% → about ${summary.squaresWithWaste.toFixed(1)} squares to order.`,
      );
      if (summary.confidence.level === "reduced") parts.push(summary.confidence.message);
      el("rt-meta").textContent = parts.join(" ");

      downloadBtn.disabled = false;
      prefillLeadForm();
    }

    function prefillLeadForm() {
      const s = state.summary;
      if (!s) return;
      const form = document.querySelector<HTMLElement>("#roof-lead");
      const addressInput = form?.querySelector<HTMLInputElement>('input[name="address"]');
      const notes = form?.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
      if (addressInput && state.address && !addressInput.value) addressInput.value = state.address;
      if (notes) {
        notes.value = `Roof size tool: ≈ ${s.squares.toFixed(1)} squares (~${fmt(s.surfaceFt2)} ft² surface, ${pitchRangeLabel(s.pitchRangeDeg)} pitch, ${s.waste.percent}% waste → ${s.squaresWithWaste.toFixed(1)} to order)${state.address ? ` at ${state.address}` : ""} — ${state.method === "aerial" ? "aerial" : "hand-traced"} measurement.`;
      }
    }

    function clearResults(prompt: string) {
      applySummary(null, state.method);
      setStatus(prompt);
    }

    loadMaps(KEY)
      .then(async (google: any) => {
        const { Map } = await google.maps.importLibrary("maps");
        const placesLib = await google.maps.importLibrary("places");
        await google.maps.importLibrary("geometry");

        const map = new Map(el("rt-map"), {
          center: { lat: 30.0799, lng: -95.4172 }, // Spring, TX
          zoom: 17,
          mapTypeId: "satellite",
          tilt: 0,
          streetViewControl: false,
          fullscreenControl: false,
          mapTypeControl: false,
        });

        // --- Address autocomplete (current Places web component) ---
        const pacHost = el("rt-pac");
        try {
          const pac = new placesLib.PlaceAutocompleteElement({ includedRegionCodes: ["us"] });
          pacHost.replaceChildren(pac);
          const handleSelection = async (prediction: any, legacyPlace: any) => {
            try {
              let place = legacyPlace;
              if (!place && prediction) {
                place = prediction.toPlace();
                await place.fetchFields({ fields: ["location", "formattedAddress"] });
              }
              const loc = place?.location;
              if (!loc) return;
              const lat = typeof loc.lat === "function" ? loc.lat() : loc.lat;
              const lng = typeof loc.lng === "function" ? loc.lng() : loc.lng;
              state.address = place.formattedAddress ?? "";
              map.setCenter({ lat, lng });
              map.setZoom(20);
              await measureAuto(lat, lng);
            } catch {
              setStatus("Couldn't read that address — try picking it from the list again.");
            }
          };
          pac.addEventListener("gmp-select", (ev: any) =>
            handleSelection(ev.placePrediction, null),
          );
          pac.addEventListener("gmp-placeselect", (ev: any) => handleSelection(null, ev.place));
        } catch {
          // Autocomplete unavailable (key scope) — manual drawing still works.
          setStatus("Address search is unavailable — pan to your home and trace the roof (✏️).");
          enableManual();
        }

        // --- Auto measurement ---
        // Primary: the site's one public key calls the Solar API straight
        // from the browser (the key is domain-locked + quota-capped, so this
        // is the whole configuration — "Wix-style" per the owner). If the
        // optional server proxy (/api/roof-measure) is ever configured in
        // Vercel, it is tried first and simply wins.
        const M2_TO_FT2 = 10.7639;

        /** Google's building insights → the shared summary shape. */
        function solarToSummary(data: any): RoofSummary | null {
          const sp = data?.solarPotential;
          const segs: any[] = Array.isArray(sp?.roofSegmentStats) ? sp.roofSegmentStats : [];
          const planes: RoofPlane[] = [];
          let roofM2 = 0;
          let planM2 = 0;
          for (const seg of segs) {
            const pitchDeg = Number(seg?.pitchDegrees ?? 0);
            const area = Number(seg?.stats?.areaMeters2 ?? 0);
            const ground = Number(seg?.stats?.groundAreaMeters2 ?? 0);
            const cos = Math.cos((pitchDeg * Math.PI) / 180) || 1;
            const segRoof = area || ground / cos;
            if (segRoof <= 0) continue;
            roofM2 += segRoof;
            planM2 += ground || area * cos;
            planes.push({
              areaFt2: segRoof * M2_TO_FT2,
              pitchDeg,
              azimuthDeg: Number(seg?.azimuthDegrees ?? 0),
            });
          }

          const wholeM2 = Number(sp?.wholeRoofStats?.areaMeters2 ?? 0);
          const wholeGroundM2 = Number(sp?.wholeRoofStats?.groundAreaMeters2 ?? 0);
          const surfaceM2 = roofM2 > 0 ? roofM2 : wholeM2;
          if (surfaceM2 <= 0) return null;

          // How far is the building Google matched from the address we asked
          // about? 20 m away can be a different house entirely.
          let buildingOffsetM: number | null = null;
          if (state.center && data?.center?.latitude != null) {
            buildingOffsetM = metresBetween(
              state.center.lat,
              state.center.lng,
              Number(data.center.latitude),
              Number(data.center.longitude),
            );
          }

          return buildRoofSummary({
            planes,
            surfaceFt2: surfaceM2 * M2_TO_FT2,
            footprintFt2: (planM2 || wholeGroundM2 || surfaceM2) * M2_TO_FT2,
            wholeRoofFt2: wholeM2 > 0 ? wholeM2 * M2_TO_FT2 : undefined,
            imageryQuality: (data?.imageryQuality ?? null) as any,
            imageryDate: data?.imageryDate ?? null,
            buildingFound: true,
            buildingOffsetM,
            method: "aerial",
          });
        }

        /** Great-circle distance in metres. */
        function metresBetween(a: number, b: number, c: number, d: number) {
          const R = 6371000;
          const toR = (x: number) => (x * Math.PI) / 180;
          const dLat = toR(c - a);
          const dLng = toR(d - b);
          const h =
            Math.sin(dLat / 2) ** 2 + Math.cos(toR(a)) * Math.cos(toR(c)) * Math.sin(dLng / 2) ** 2;
          return Math.round(2 * R * Math.asin(Math.sqrt(h)));
        }

        /**
         * Outline every plane Google measured, so the homeowner can SEE which
         * building was measured. A wrong match (garage, neighbour) is obvious
         * on sight and invisible in the numbers alone.
         */
        let measuredShapes: any[] = [];
        function clearMeasuredShapes() {
          measuredShapes.forEach((s) => s.setMap(null));
          measuredShapes = [];
          el("rt-verify").classList.add("hidden");
          hideBigger();
        }
        function drawMeasuredShapes(data: any) {
          clearMeasuredShapes();
          const segs: any[] = data?.solarPotential?.roofSegmentStats ?? [];

          // ONE outline around the whole measured building, not one box per
          // roof plane. Google gives us axis-aligned bounding boxes, not real
          // facet shapes, so drawing all 17 of them was both a visual mess and
          // a false claim of precision (owner, 2026-10). All this marker needs
          // to answer is "did we measure YOUR building?".
          let south = 90,
            north = -90,
            west = 180,
            east = -180;
          let found = false;
          for (const seg of segs) {
            const bb = seg?.boundingBox;
            if (!bb?.sw || !bb?.ne) continue;
            south = Math.min(south, bb.sw.latitude, bb.ne.latitude);
            north = Math.max(north, bb.sw.latitude, bb.ne.latitude);
            west = Math.min(west, bb.sw.longitude, bb.ne.longitude);
            east = Math.max(east, bb.sw.longitude, bb.ne.longitude);
            found = true;
          }
          if (!found) return;

          measuredShapes.push(
            new google.maps.Rectangle({
              map,
              bounds: { south, north, west, east },
              fillColor: "#C9A26C",
              fillOpacity: 0.12,
              strokeColor: "#C9A26C",
              strokeWeight: 2.5,
              clickable: false,
              zIndex: 1,
            }),
          );
          el("rt-verify").classList.remove("hidden");
        }

        /**
         * findClosest returns the nearest building CENTRE, so a shed 2 m away
         * beats the actual house whose centre sits 21 m off. Measured against
         * six EagleView reports, that mis-pick was the single biggest source
         * of error (two roofs came back at 55% and 68% of true).
         *
         * No automatic rule fixed it safely — "biggest within 30 m" repaired
         * those two but overshot another by 30% (Sheet 8 addendum 3). So we
         * OFFER the alternative instead of silently switching: one probe ring,
         * and if something materially bigger is adjacent, the homeowner gets a
         * one-tap way to correct it.
         */
        const biggerBtn = el("rt-bigger") as HTMLButtonElement;
        let biggerTarget: { lat: number; lng: number } | null = null;

        function hideBigger() {
          biggerBtn.classList.add("hidden");
          biggerTarget = null;
        }

        async function offerBiggerBuilding(lat: number, lng: number, currentFt2: number) {
          hideBigger();
          const STEP = 0.00018; // ~20 m
          const probes: [number, number][] = [
            [STEP, 0],
            [-STEP, 0],
            [0, STEP],
            [0, -STEP],
          ];
          let best: { ft2: number; lat: number; lng: number } | null = null;
          for (const [dy, dx] of probes) {
            const d = await fetchSolar(lat + dy, lng + dx);
            const segs: any[] = d?.solarPotential?.roofSegmentStats ?? [];
            if (!segs.length || !d?.center) continue;
            const ft2 =
              segs.reduce((a, x) => a + Number(x?.stats?.areaMeters2 ?? 0), 0) * M2_TO_FT2;
            if (ft2 > (best?.ft2 ?? 0)) {
              best = { ft2, lat: d.center.latitude, lng: d.center.longitude };
            }
          }
          // Only worth interrupting for a clearly different structure.
          if (!best || best.ft2 < currentFt2 * 1.25) return;
          biggerTarget = { lat: best.lat, lng: best.lng };
          el("rt-bigger-msg").textContent =
            ` If your house is the larger one, tap here to measure it instead — about ${(best.ft2 / 100).toFixed(1)} squares.`;
          biggerBtn.classList.remove("hidden");
        }

        biggerBtn.addEventListener("click", () => {
          if (biggerTarget) measureAuto(biggerTarget.lat, biggerTarget.lng);
        });

        async function fetchSolar(lat: number, lng: number): Promise<any | null> {
          try {
            const res = await fetch(
              "https://solar.googleapis.com/v1/buildingInsights:findClosest" +
                `?location.latitude=${lat}&location.longitude=${lng}` +
                `&requiredQuality=LOW&key=${encodeURIComponent(KEY)}`,
            );
            if (!res.ok) return null;
            return await res.json();
          } catch {
            return null;
          }
        }

        async function measureAuto(lat: number, lng: number) {
          setStatus("Measuring your roof from aerial imagery…");
          state.center = { lat, lng };
          try {
            const raw = await fetchSolar(lat, lng);
            const summary = raw ? solarToSummary(raw) : null;
            if (!summary) {
              applySummary(null, "aerial");
              showBlocked(
                "We couldn't find usable aerial roof data for this address. Trace it yourself with the ✏️ tool, or let us measure it on site — free either way.",
              );
              setStatus("No aerial roof data here — trace it yourself (✏️) or book a free check.");
              enableManual();
              return;
            }

            state.mode = "auto";
            drawMeasuredShapes(raw);
            applySummary(summary, "aerial");

            if (summary.confidence.level === "blocked") {
              // Trees or poor imagery — offer the honest alternatives.
              setStatus(
                "Can't measure this one from the air — trace it yourself (✏️) or book a free on-site measurement.",
              );
              enableManual();
              return;
            }

            disableManual();
            setStatus("Done — measured plane by plane. Not your roof? Tap your house on the map.");
            void offerBiggerBuilding(lat, lng, summary.surfaceFt2);
          } catch {
            setStatus("Measurement hiccup — trace your roof with the ✏️ tool instead.");
            enableManual();
          }
        }

        // --- Manual tracing: tap the roof's corners, no Google toolbar ---
        // (The drawing-library toolbar proved unreliable and is clumsy on
        // phones anyway; plain map clicks + an editable Polygon work
        // everywhere and keep the buttons in our own UI.)
        let tracing = false;
        let currentPoly: any = null;
        const traceBtnEls = () =>
          Array.from(document.querySelectorAll<HTMLElement>(".rt-tracebtn"));
        function enableManual() {
          state.mode = "manual";
          tracing = true;
          el("rt-pitch").classList.remove("hidden");
          el("rt-pitch").classList.add("flex");
          traceBtnEls().forEach((b) => b.classList.remove("hidden"));
          map.setOptions({ draggableCursor: "crosshair" });
        }
        function disableManual() {
          tracing = false;
          currentPoly = null;
          el("rt-pitch").classList.add("hidden");
          el("rt-pitch").classList.remove("flex");
          traceBtnEls().forEach((b) => b.classList.add("hidden"));
          map.setOptions({ draggableCursor: undefined });
        }
        map.addListener("click", (e: any) => {
          if (!e.latLng) return;
          // Not tracing? A click re-runs the measurement on whatever building
          // you tapped. This is the only real defence against a confidently
          // wrong match: every automated check we have compares Google's
          // geocode against Google's own building model, so when those two
          // agree with each other and disagree with reality, nothing catches
          // it but a person looking at the map (owner bug report, 2026-10).
          if (!tracing) {
            measureAuto(e.latLng.lat(), e.latLng.lng());
            return;
          }
          if (!currentPoly) {
            currentPoly = new google.maps.Polygon({
              map,
              paths: [e.latLng],
              editable: true,
              fillColor: "#C9A26C",
              fillOpacity: 0.25,
              strokeColor: "#C9A26C",
              strokeWeight: 2,
            });
            state.polygons.push(currentPoly);
            const path = currentPoly.getPath();
            ["insert_at", "remove_at", "set_at"].forEach((evt) =>
              path.addListener(evt, computeManual),
            );
          } else {
            currentPoly.getPath().push(e.latLng);
          }
          computeManual();
        });
        el("rt-undo").addEventListener("click", () => {
          if (!currentPoly) return;
          const path = currentPoly.getPath();
          if (path.getLength() > 1) {
            path.pop();
          } else {
            currentPoly.setMap(null);
            state.polygons.pop();
            currentPoly = null;
          }
          computeManual();
        });
        el("rt-newsection").addEventListener("click", () => {
          currentPoly = null;
          setStatus("New section started — tap its corners on the map.");
        });
        el("rt-clear").addEventListener("click", () => {
          state.polygons.forEach((p) => p.setMap(null));
          state.polygons = [];
          currentPoly = null;
          computeManual();
        });
        function computeManual() {
          // The slope multiplier is sec(pitch), so pitch = acos(1/mult).
          const pitchDeg = (Math.acos(1 / state.pitchMult) * 180) / Math.PI;
          const planes: RoofPlane[] = [];
          let planM2 = 0;
          state.polygons.forEach((poly) => {
            const path = poly.getPath().getArray();
            if (path.length < 3) return;
            const areaM2 = google.maps.geometry.spherical.computeArea(path);
            if (areaM2 <= 0) return;
            planM2 += areaM2;
            // One traced section = one plane, so complexity still drives waste.
            planes.push({
              areaFt2: areaM2 * M2_TO_FT2 * state.pitchMult,
              pitchDeg,
              azimuthDeg: 0, // not measurable from a traced outline
            });
          });
          const planFt2 = planM2 * M2_TO_FT2;
          if (planFt2 > 0) {
            // Centre the report's aerial photo on what they actually traced.
            const bounds = new google.maps.LatLngBounds();
            state.polygons.forEach((poly) =>
              poly
                .getPath()
                .getArray()
                .forEach((pt: any) => bounds.extend(pt)),
            );
            const c = bounds.getCenter();
            state.center = { lat: c.lat(), lng: c.lng() };

            applySummary(
              buildRoofSummary({
                planes,
                surfaceFt2: planFt2 * state.pitchMult,
                footprintFt2: planFt2,
                imageryQuality: null,
                method: "manual",
              }),
              "manual",
            );
            setStatus("Keep tapping corners or drag the dots to fine-tune — numbers update live.");
          } else {
            applySummary(null, "manual");
            const n = currentPoly ? currentPoly.getPath().getLength() : 0;
            setStatus(
              n > 0
                ? `${n} corner${n === 1 ? "" : "s"} placed — a shape needs at least 3.`
                : "Tap your roof's corners on the map, one by one — the outline builds as you go.",
            );
          }
        }

        // --- Pitch chips ---
        document.querySelectorAll<HTMLButtonElement>(".rt-pitch-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            document
              .querySelectorAll(".rt-pitch-btn")
              .forEach((b) => b.classList.remove("rt-pitch-active"));
            btn.classList.add("rt-pitch-active");
            state.pitchMult = Number(btn.dataset.mult) || 1.118;
            computeManual();
          });
        });

        // --- Buttons ---
        el("rt-draw").addEventListener("click", () => {
          enableManual();
          computeManual();
        });
        el("rt-reset").addEventListener("click", () => {
          state.polygons.forEach((p) => p.setMap(null));
          state.polygons = [];
          state.address = "";
          state.mode = "auto";
          state.center = null;
          clearMeasuredShapes();
          disableManual();
          clearResults("Start typing and pick your address — we'll find your roof.");
        });

        // --- Download the branded PDF report ---
        // pdf-lib and the brand fonts are pulled in only on click, so the page
        // itself stays light. Everything runs in the browser: no key, no
        // server round trip, nothing stored.
        const dlLabel = el("rt-download-label");
        downloadBtn.addEventListener("click", async () => {
          const summary = state.summary;
          if (!summary || downloadBtn.disabled) return;
          const original = dlLabel.textContent;
          downloadBtn.disabled = true;
          dlLabel.textContent = "Building your report…";
          try {
            const [{ buildRoofReportPdf, reportFilename }, propertyImage] = await Promise.all([
              import("~/lib/roof-report-pdf"),
              fetchPropertyImage(),
            ]);
            const bytes = await buildRoofReportPdf({
              summary,
              address: state.address,
              propertyImage,
              method: state.method,
            });
            const blob = new Blob([bytes as BlobPart], { type: "application/pdf" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = reportFilename(state.address);
            document.body.appendChild(a);
            a.click();
            a.remove();
            // Give the browser a beat to start the download before revoking.
            setTimeout(() => URL.revokeObjectURL(url), 10_000);
            dlLabel.textContent = "Report downloaded ✓";
            setTimeout(() => (dlLabel.textContent = original), 4000);
          } catch {
            dlLabel.textContent = "Couldn't build the report — try again";
            setTimeout(() => (dlLabel.textContent = original), 4000);
          } finally {
            downloadBtn.disabled = false;
          }
        });

        /** Public-domain USGS aerial for the cover. Optional by design. */
        async function fetchPropertyImage(): Promise<Uint8Array | null> {
          if (!state.center) return null;
          try {
            const res = await fetch(
              `/api/property-image?lat=${state.center.lat}&lng=${state.center.lng}`,
            );
            if (res.status !== 200) return null;
            const buf = await res.arrayBuffer();
            return buf.byteLength > 0 ? new Uint8Array(buf) : null;
          } catch {
            return null;
          }
        }
      })
      .catch(() => {
        setStatus(
          "The map couldn't load. Refresh to retry — or skip it: measurement is free in person.",
        );
      });
  }
</script>
