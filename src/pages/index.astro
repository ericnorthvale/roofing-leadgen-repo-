---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import TrustBar from "@components/TrustBar.astro";
import ServiceCard from "@components/ServiceCard.astro";
import LeadForm from "@components/LeadForm.astro";
import Reviews from "@components/Reviews.astro";
import BeforeAfter from "@components/BeforeAfter.astro";
import ImagePlaceholder from "@components/ImagePlaceholder.astro";
import Faq from "@components/Faq.astro";
import TableOfContents from "@components/TableOfContents.astro";
import VillageShowcase from "@components/VillageShowcase.astro";
import { BRAND } from "~/lib/brand";
import { SERVICE_AREAS } from "~/lib/service-areas";
import { aggregateRatingJsonLd, faqPageJsonLd } from "~/lib/seo";
import { getSiteReviews } from "~/lib/reviews";

// Data-driven so the eyebrow always reflects every city we actually serve.
const areasLine = Object.values(SERVICE_AREAS)
  .map((a) => a.name)
  .join(" · ");

const faqs = [
  {
    q: "How much does a roof replacement cost in The Woodlands?",
    a: "Every roof is priced from its own size, pitch, material, and decking condition — we put your exact price in writing before we leave the driveway. For market context: Angi (2026) reports a national average of $9,602 with most projects between $5,900 and $46,000, and Modernize (2026) lists architectural shingle at roughly $4.11–$5.57 per square foot installed. Larger Woodlands homes with complex rooflines trend above national averages.",
  },
  {
    q: "Do I need a permit to replace my roof in The Woodlands?",
    a: "No county building permit — Montgomery County's permitting FAQ states residential properties do not require a permit for a roof. What you do need is prior written approval from your village's Residential Design Review Committee under The Woodlands Township's 2024 Residential Development Standards, which cover all roof replacement (and even roofing repairs). We prepare and file that application as part of every job.",
  },
  {
    q: "How does the HOA / Township approval work?",
    a: "Applications go through the Township's Civic Access Portal to your village RDRC, with product samples where required. The Standards give committees up to 45 days to act (most approvals come back much sooner), no property survey is needed for a re-roof, and some items — like gutters and color-compatible roof vents — are pre-approved. We handle the paperwork end to end and never order material before approval.",
  },
  {
    q: "How long does a roof replacement take?",
    a: "Most single-family replacements are installed in one day; larger or steep, complex homes take two. The longer pole is the covenant approval, which is why we file the RDRC application early. Your named project manager confirms the schedule in writing before work begins.",
  },
  {
    q: "How long does a roof last in this climate?",
    a: "InterNACHI's life-expectancy chart puts 3-tab asphalt around 20 years and architectural shingles around 30 — and notes hot climates drastically reduce asphalt shingle life. Gulf Coast heat, humidity, UV, and storm exposure all push local roofs toward the early end of those ranges, which is why free annual inspections are worth their price.",
  },
  {
    q: "Can insurance pay for my roof?",
    a: "If a covered peril (hail, wind, falling limbs) caused the damage, yes — subject to your policy type. Replacement-cost policies pay current prices in two parts (depreciated value first, the rest after proof of repairs); actual-cash-value policies deduct depreciation, which per TDI's example can leave a 20-year-old roof paying out $4,000 on a $10,000 replacement. We document damage to claim standard and tell you honestly whether filing is justified.",
  },
  {
    q: "How soon after hail should I get an inspection?",
    a: "Promptly. Hail bruising isn't always visible from the ground, TDI notes some policies carry one-year claim deadlines (check your contract), and evidence is freshest right after the storm. NOAA logs damaging hail in Montgomery County nearly every year — if hail moved through your area, a free documented inspection settles the question either way.",
  },
  {
    q: "Can you repair my roof instead of replacing it?",
    a: "Whenever a sound repair buys you years, that's what we recommend — most repairs run same-day or next-day. If the roof is at end of life, we'll show you the photos that prove it and put both options in writing. The decision stays yours.",
  },
  {
    q: "What shingles last longest here?",
    a: "Among asphalt products, premium architectural lines with strong wind and algae warranties do best in this climate — we install IKO Dynasty as standard and IKO Nordic when you want Class 4 impact resistance, both with a 130-mph wind warranty and a 10-year algae warranty for Gulf-Coast streaking. For maximum service life, the Metal Roofing Alliance puts standing-seam metal at 30–50+ years, and the Township Standards accept non-glossy metal.",
  },
  {
    q: "What wind rating should I look for?",
    a: "Wind resistance comes down to the warranty and the install detail: IKO Dynasty and Nordic both carry a 130-mph limited high-wind warranty when applied to IKO's requirements, thanks to the reinforced ArmourZone nailing band that resists uplift. Just as important is sealing the edges — a proper starter course at the eaves and rakes is where most wind failures begin.",
  },
  {
    q: "What happens during your inspection?",
    a: "A forty-photo documented walk of every slope, valley, penetration, and — where accessible — your attic: hail and wind evidence, granule loss, nail pops, flashing condition, pipe boots, ventilation. You get written findings within 24 hours with an estimated remaining life. Free, no obligation, no door-knocking.",
  },
  {
    q: "Class 3 vs Class 4 shingles — what's the difference?",
    a: "UL 2218 impact classes: Class 3 shingles withstand a 1.75-inch steel ball in drop testing, Class 4 a 2-inch ball — Class 4 is the highest rating. TDI notes Class 4 coverings receive the highest premium credit where insurers offer discounts, but each company sets its own amount. We quote standard and impact-rated options side by side.",
  },
  {
    q: "A roofer offered to cover my deductible. Is that legal?",
    a: "No. Texas Insurance Code §707.002 requires policyholders to pay their deductible, and Business & Commerce Code §27.02 makes it an offense for a contractor to pay, waive, or absorb it — TDI warns of fines and jail time, and insurers can require proof of payment before releasing full claim funds. Treat the offer as a red flag about everything else that contractor does.",
  },
  {
    q: "Do you handle metal, tile, and slate roofs?",
    a: "Yes. The Township Standards accept tile, slate, composition shingles, and stone-coated or standing-seam metal (non-glossy) — and premium systems are the norm in villages like Carlton Woods and Sterling Ridge. Their failure points are underlayment, flashing, and fasteners rather than the field material, which is exactly what our inspections target.",
  },
  {
    q: "Why does my roof have black streaks, and is it damage?",
    a: "Almost always algae — Gloeocapsa magma, which ARMA identifies as the most prevalent roof-discoloration species and notes is most widespread in the Gulf States. The stains don't weaken shingles by themselves, but never power-wash them (ARMA warns pressure washing damages asphalt roofing). Algae-resistant shingles with copper granules prevent it on your next roof.",
  },
  {
    q: "Does attic ventilation really matter in Texas?",
    a: "Enormously. ARMA notes a poorly-vented attic can reach 140°F on a 90°F day, cooking shingles from below and shortening roof life. The guideline is 1 square foot of net free vent area per 300 square feet of attic, balanced between intake at the soffits and exhaust at the ridge — something we evaluate on every inspection and correct on every replacement.",
  },
];

// AggregateRating rides along only once real reviews exist (null until then —
// the homepage shows the same review set in the <Reviews /> section below).
const siteUrl = Astro.site?.toString() ?? "https://northvaleroofing.com";
const aggregateRating = aggregateRatingJsonLd(siteUrl, await getSiteReviews());
---

<BaseLayout
  seo={{
    title: "Roofing Company The Woodlands TX | Roof Repair & Replacement | Northvale Roofing",
    description:
      "Roof replacement, roof repair, storm damage restoration, insurance claims & free inspections in The Woodlands, Spring, Magnolia, Conroe & North Houston.",
    pathname: "/",
    jsonLd: aggregateRating ? [faqPageJsonLd(faqs), aggregateRating] : faqPageJsonLd(faqs),
  }}
>
  <Hero
    eyebrow={areasLine}
    headline="Same-day roof inspections in The Woodlands — estimate in writing before we leave."
    subhead={`Roof replacement, roof repair, and storm damage across The Woodlands, Spring, and North Houston. A named project manager on every job, and the Township's roofing Standards handled for you.`}
    primaryCta={{ href: "/contact", label: "Book my inspection", ctaId: "home-book" }}
    secondaryCta={{ href: "/storm-response", label: "Storm today?", ctaId: "home-storm" }}
    image={{
      slot: "HERO: crew on a finished roof, golden hour",
      alt: "Northvale Roofing crew on a completed roof in The Woodlands at golden hour",
      demoKey: "hero",
    }}
  />

  <TrustBar />

  <section class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <h2 class="text-3xl md:text-4xl">What we do</h2>
    <div class="rule-gold mt-5" aria-hidden="true"></div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <ServiceCard
        href="/the-woodlands/roof-replacement"
        title="Roof replacement"
        blurb="Tear-off to deck, Standards-compliant materials, RDRC paperwork handled. Exact price in writing first."
        image={{
          slot: "SERVICE: new architectural-shingle roof",
          alt: "Finished architectural-shingle roof replacement",
          demoKey: "svc-replacement",
        }}
      />
      <ServiceCard
        href="/the-woodlands/roof-repair"
        title="Roof repair"
        blurb="Leaks, pipe boots, flashing, wind damage — usually same-day or next-day."
        image={{
          slot: "SERVICE: roofer repairing flashing / shingles",
          alt: "Roofer repairing lifted shingles and flashing",
          demoKey: "svc-repair",
        }}
      />
      <ServiceCard
        href="/the-woodlands/roof-inspection"
        title="Roof inspection"
        badge="Free"
        blurb="Forty-photo packet. Written findings within 24 hours. No obligation, no pressure."
        image={{
          slot: "SERVICE: inspector photographing a roof",
          alt: "Inspector documenting a roof for the forty-photo packet",
          demoKey: "svc-inspection",
        }}
      />
      <ServiceCard
        href="/the-woodlands/storm-damage"
        title="Storm damage"
        blurb="Hail, wind, fallen-limb impact. We document everything your adjuster will ask for."
        image={{
          slot: "SERVICE: hail/wind-damaged roof close-up",
          alt: "Close-up of hail and wind damage on a roof",
          demoKey: "svc-storm",
        }}
      />
      <ServiceCard
        href="/the-woodlands/insurance-claims"
        title="Insurance claims"
        blurb="Texas claim rules, deadlines, and documentation — from the contractor, not a public adjuster."
        image={{
          slot: "SERVICE: adjuster meeting on a roof",
          alt: "Project manager meeting an insurance adjuster on site",
          demoKey: "svc-insurance",
        }}
      />
      <ServiceCard
        href="/the-woodlands"
        title="The Woodlands villages"
        blurb="Village-by-village pages for Grogan's Mill through Creekside Park — roof ages, covenants, and what we see on your streets."
        image={{
          slot: "NEIGHBORHOOD: tree-lined Woodlands street",
          alt: "Tree-lined residential street in The Woodlands",
          demoKey: "neighborhood",
        }}
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4">
    <TableOfContents
      heading="The Woodlands roofing guide"
      items={[
        { id: "why-roofs-fail", label: "Why roofs fail in The Woodlands" },
        { id: "materials", label: "Roofing materials we install" },
        { id: "neighborhoods", label: "Neighborhoods we serve" },
        { id: "hoa-roofing", label: "HOA & Township approvals" },
        { id: "permits-codes", label: "Permits & codes in Montgomery County" },
        { id: "faq", label: "Frequently asked questions" },
      ]}
    />
  </section>

  <section
    class="border-y border-[color:var(--color-navy-100)] bg-[color:var(--color-surface-ivory)]"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <article class="prose-northvale max-w-3xl">
        <h2 id="why-roofs-fail">Why roofs fail in The Woodlands</h2>
        <p>
          Roofs don't fail randomly here — they fail on a schedule written by this climate. Knowing
          the failure modes is how you catch them at repair price instead of replacement price.
        </p>
        <p>
          <strong>Heat and UV.</strong> NOAA's climate normals put July and August highs around 94–95°F
          at the nearest first-order station, and the Asphalt Roofing Manufacturers Association notes
          a poorly-ventilated attic can reach 140°F on a 90°F day. That heat dries the asphalt binder
          in shingles; once protective granules displace, IBHS research shows the exposed asphalt embrittles
          and ages faster. Heat is the quiet failure mode — no storm required.
        </p>
        <p>
          <strong>Hail.</strong> NOAA's Storm Events Database records damaging hail (¾-inch or larger)
          somewhere in Montgomery County nearly every year — one-inch hail fell near Shenandoah as recently
          as June 2025. IBHS impact research adds a subtler point: repeated <em>small</em> hail plus normal
          weathering can make shingles perform like decade-older material, so a roof can be storm-weakened
          without a single dramatic event.
        </p>
        <p>
          <strong>Wind.</strong> The National Weather Service counts 50–60 thunderstorm days a year in
          southeast Texas, a third of them severe, with downbursts driving 60 to 100+ mph winds — and
          tropical systems reach us too: Hurricane Beryl (2024) produced a measured 69-mph gust at Conroe,
          well inland. What actually fails in wind, per IBHS, is the sealant bond between shingles, and
          that bond weakens with age.
        </p>
        <p>
          <strong>Humidity and algae.</strong> The black streaks on so many local roofs are
          <em>Gloeocapsa magma</em>, the algae ARMA identifies as most widespread in the Gulf
          States. The stains themselves don't destroy shingles — but the shade and moisture patterns
          that feed them also slow drying, and pressure-washing them off does real damage.
        </p>
        <p>
          <strong>Pine needles and tree debris.</strong> The forest is the whole point of The Woodlands
          — and a working load on its roofs. Needles and leaves pack into valleys and gutters, hold moisture
          against shingles, and back water up under the roof edge. The Township's own covenants require
          owners to keep roofs clear of leaves, needles, and branches; extension-service guidance adds
          trimming limbs that overhang the roof.
        </p>
        <p>
          <strong>Heavy rain and flashing failures.</strong> Annual rainfall runs near 50 inches here
          — and in 2017, Harvey dropped 25.66 inches on The Woodlands in days. Water finds the weak detail,
          and the weak detail is usually flashing: the code's entire purpose for it is keeping moisture
          out of roof and wall joints (IRC R903.2). Aged step flashing, cracked pipe boots (the rubber
          commonly fails within 10–15 years), and nail pops are the leaks we chase most.
        </p>

        <h2 id="materials">Roofing materials we install</h2>
        <p>
          Every material below complies with the Township's Standards — muted colors, no glossy
          metal — and every spec here comes from the manufacturer's own documentation.
        </p>
        <h3>IKO Dynasty — our standard architectural shingle</h3>
        <p>
          We standardize on IKO. Dynasty is a laminated architectural shingle built around the
          <strong>ArmourZone</strong> — a 1¼-inch reinforced, woven nailing band that gives the fasteners
          a wider, tougher target and resists the wind uplift that peels ordinary shingles. It carries
          a
          <strong>130-mph limited high-wind warranty</strong>, a <strong>Limited Lifetime</strong> product
          warranty, IKO's <strong>15-year non-prorated Iron Clad Protection</strong>, a <strong
            >10-year algae-resistance warranty</strong
          > for Gulf-Coast streaking, and a Class A fire rating — in more colors than any other IKO line.
          Every spec here is IKO's own published data.
        </p>
        <h3>IKO Nordic — the Class 4 impact-resistant upgrade</h3>
        <p>
          Nordic is IKO's highest-performing line: the mat is <strong
            >polymer-modified (SBS) asphalt</strong
          >
          that flexes like a shock absorber, earning the highest hail rating, <strong
            >UL 2218 Class 4</strong
          >. It shares Dynasty's ArmourZone, 130-mph wind warranty, Limited Lifetime coverage,
          15-year Iron Clad Protection, and 10-year algae warranty. For hail-exposed Montgomery
          County roofs — and homeowners chasing an insurance discount — it's the upgrade we quote
          right beside Dynasty.
        </p>
        <h3>Class 3 vs. Class 4 — and what it means for insurance</h3>
        <p>
          UL 2218 Class 4 is the top impact rating (surviving a 2-inch steel ball in drop testing);
          Class 3 withstands a 1.75-inch ball. Important honesty from IKO: the rating is a lab
          classification, <em>not</em>
          a guarantee against hail, and hail damage isn't covered by the shingle warranty. Its real value
          is that it can help you qualify for an insurance premium discount where your carrier offers
          one — TDI notes Class 4 coverings receive the highest available credit, but each company sets
          its own amount, so ask yours.
        </p>
        <h3>Standing-seam & stone-coated metal</h3>
        <p>
          The Township Standards accept metal in non-glossy finishes, and the Metal Roofing Alliance
          rates metal roofs at 30–50+ years of service life — two to three times asphalt — with
          140-mph wind ratings. Standing seam's concealed fasteners eliminate the gasketed-screw
          maintenance cycle of exposed-fastener panels. Expect roughly two to three times the cost
          of asphalt (MRA), quoted in writing next to your shingle options.
        </p>
        <h3>Architectural vs. 3-tab</h3>
        <p>
          We install architectural (dimensional) shingles as standard. InterNACHI's life-expectancy
          chart gives 3-tab about 20 years vs. about 30 for architectural — before the hot-climate
          penalty — and a 130-mph wind warranty is coverage a 3-tab roof simply can't match.
        </p>
        <p class="mt-4">
          Weighing Dynasty against the Class 4 Nordic upgrade? Our <a
            href="/services/roof-replacement">roof replacement guide</a
          > walks through the full system, warranty, and what drives the quote.
        </p>

        <h2 id="neighborhoods">Neighborhoods we serve in The Woodlands</h2>
        <p>
          The Woodlands built out village by village over five decades, so roof age, housing stock,
          and re-roof questions differ street to street. Each village page below covers its
          development era, its housing stock, and how covenant approval works there.
        </p>
      </article>

      <VillageShowcase />

      <article class="prose-northvale mt-10 max-w-3xl">
        <p>
          Beyond The Woodlands we serve {areasLine.replace("The Woodlands · ", "")} — see the
          <a href="/sitemap"> full service area</a>.
        </p>

        <h2 id="hoa-roofing">HOA roofing: Township approvals, handled</h2>
        <p>
          Nothing separates roofing in The Woodlands from roofing anywhere else like the covenant
          layer. The Township's 2024 Residential Development Standards require prior written
          approval from your village's Residential Design Review Committee — nine elected village
          committees, staffed by the Township's Covenant Administration Department — for <em>all</em
          > roof replacement, and even roofing repairs require a permit at the time of repair.
        </p>
        <p>What the Standards actually say about your roof:</p>
        <ul>
          <li>
            Colors must be <strong>muted, without color pattern</strong>, harmonizing with the
            natural landscape and community.
          </li>
          <li>
            Acceptable materials: tile, slate, composition shingles, stone-coated or standing-seam
            metal, and cement-fiberboard — with all metal free of glossy finish.
          </li>
          <li>
            Exposed roof accessories — vents, flashing, attic ventilators, chimney caps — must match
            or be compatible with the roof color; vents and stacks go on rear slopes where possible.
          </li>
          <li>
            Committees have up to <strong>45 days</strong> to act on a complete application; no property
            survey is required for a re-roof; gutters, downspouts, and color-compatible roof vents are
            pre-approved without any application.
          </li>
          <li>
            Decisions can be appealed in writing within 10 days to the Development Standards
            Committee — the only body with variance power.
          </li>
        </ul>
        <p>
          We treat the approval as part of the roofing job: compliant material samples at your
          driveway, the application filed through the Township's Civic Access Portal, and material
          ordered only after approval. Deed-restriction enforcement is real here — doing it right
          the first time is cheaper than doing it twice. (One quirk we track: homes in Grogan's
          Forest Sections 5, 6 &amp; 7 submit roof applications to the City of Shenandoah instead.)
        </p>

        <h2 id="permits-codes">Permits & codes in Montgomery County</h2>
        <p>
          The permit picture surprises most homeowners: <strong
            >unincorporated Montgomery County — which includes most of The Woodlands — does not
            require a building permit for a residential re-roof.</strong
          > That's the county's own permitting FAQ, not roofer folklore. The Harris County side (Creekside
          Park) runs on a floodplain-oriented development-permit system that doesn't list re-roofs either;
          incorporated neighbors differ (Shenandoah runs a full roofing permit program with wind-load
          and color rules, and the City of Houston requires re-roof permits).
        </p>
        <p>
          No permit doesn't mean no standards. The residential code still defines what a correct
          roof is, and we build to it:
        </p>
        <ul>
          <li>
            <strong>Tear-off, not roof-over</strong> — IRC R908.3 requires removing existing coverings
            down to the deck (and prohibits covering water-soaked decks or stacking a third layer).
          </li>
          <li>
            <strong>Drip edge at eaves and rakes</strong> — R905.2.8.5, with proper overlaps and fastening.
          </li>
          <li>
            <strong>Flashing that keeps water out of every joint</strong> — R903.2, the section your leak
            was probably violating.
          </li>
          <li>
            <strong>Balanced attic ventilation</strong> — R806's 1-in-150 baseline (1-in-300 with proper
            high/low balance), which in this climate is the difference between a roof that lasts and an
            attic oven.
          </li>
          <li>
            <strong>Wind-rated products and fastening</strong> — the ASTM D3161/D7158 classes the code
            maps to local design wind speeds; inland Montgomery County sits outside TDI's coastal windstorm
            (TWIA) zone, but we spec and nail for the storms this county actually gets.
          </li>
        </ul>
        <p>
          The details — underlayment, ice-and-water membrane at valleys and penetrations, decking
          replacement when rot appears — are covered in
          <a href="/the-woodlands/roof-replacement"> our Woodlands roof replacement guide</a>.
        </p>
      </article>
    </div>
  </section>

  <BeforeAfter
    heading="See the difference"
    intro="Real Northvale projects in The Woodlands and NW Houston. We document every job start to finish — these slots fill with our own work, never stock photos."
  />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-[1fr_420px]">
    <div class="prose-northvale">
      <h2>Why homeowners in Creekside Park and Grogan's Mill call us</h2>
      <p>
        We live here. We drive through The Woodlands on the way to work. When a thunderstorm rolls
        in off Lake Conroe, we're already loading ladders.
      </p>
      <p>
        Quality work in this market isn't the cheapest, and we don't pretend to be — we're the ones
        you call when you want it done right the first time. If someone quoted you a rock-bottom
        number for a full replacement, call us. We'll tell you what they're cutting.
      </p>
      <ul>
        <li>
          <strong>Same-day inspection</strong> — booked when you call. No "one of our team members will
          reach out."
        </li>
        <li>
          <strong>Written estimate</strong> — before we leave the driveway. Not "within 24–48 hours."
        </li>
        <li>
          <strong>Named project manager</strong> — you'll have a cell number and a name. Not a dispatcher.
        </li>
        <li>
          <strong>Forty-photo documentation packet</strong> — especially useful for insurance claims.
        </li>
        <li><strong>Under-60-second response</strong> — text us 8am–9pm CT and hear back fast.</li>
      </ul>
      <p><a href="/about">Read our story →</a></p>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <ImagePlaceholder
          slot="CREW: named project manager on a job site"
          alt="Northvale Roofing project manager reviewing a roof with a homeowner"
          demoKey="crew-pm"
          ratio="3/2"
          tone="navy"
        />
        <ImagePlaceholder
          slot="TRUCK: branded Northvale vehicle on a local street"
          alt="Branded Northvale Roofing truck parked at a job in The Woodlands"
          demoKey="truck"
          ratio="3/2"
          tone="mixed"
        />
      </div>
    </div>
    <div>
      <LeadForm source="home-hero-sidebar" />
    </div>
  </section>

  <Reviews />

  <div id="faq">
    <Faq items={faqs} heading="The Woodlands roofing questions, answered" />
  </div>

  <section class="bg-[color:var(--color-navy-950)] text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center md:py-24">
      <h2 class="text-4xl text-white md:text-5xl">Ready when you are.</h2>
      <div class="rule-gold mx-auto mt-6" aria-hidden="true"></div>
      <p class="mx-auto mt-6 max-w-xl text-[color:var(--color-navy-100)]">{BRAND.promise}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/contact" data-cta-id="footer-band-book"
          >Book my inspection</a
        >
        <a class="btn btn-ghost-dark" href="/storm-response" data-cta-id="footer-band-storm"
          >Storm today?</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
