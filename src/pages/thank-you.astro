---
import BaseLayout from "@layouts/BaseLayout.astro";
import { renderDataLayerPush } from "~/lib/analytics";
import { BRAND } from "~/lib/brand";

const conversionScript = renderDataLayerPush({
  eventName: "lead_submitted",
  value: 75,
  currency: "USD",
});

// Google Ads conversion — needs both the AW id and the per-action label.
const adsIdRaw = import.meta.env.GOOGLE_ADS_CONVERSION_ID;
const adsLabelRaw = import.meta.env.GOOGLE_ADS_CONVERSION_LABEL;
const adsSendTo =
  adsIdRaw && /^AW-\w+$/.test(adsIdRaw) && adsLabelRaw && /^[\w-]+$/.test(adsLabelRaw)
    ? `${adsIdRaw}/${adsLabelRaw}`
    : undefined;
const metaPixelId = import.meta.env.META_PIXEL_ID;
const metaPixelOn = Boolean(metaPixelId && /^\d+$/.test(metaPixelId));

// The browser pixel Lead fire reuses the event id generated in LeadForm (via
// sessionStorage), so Meta de-dupes it against the server CAPI event.
const pixelConversionScript = `(function(){var id;try{id=sessionStorage.getItem("nv_event_id")||undefined;sessionStorage.removeItem("nv_event_id");}catch(e){}${metaPixelOn ? `if(window.fbq){fbq('track','Lead',{value:75,currency:'USD'},id?{eventID:id}:undefined);}` : ""}${adsSendTo ? `if(window.gtag){gtag('event','conversion',{send_to:'${adsSendTo}',value:75,currency:'USD',transaction_id:id||''});}` : ""}})();`;
---

<BaseLayout
  seo={{
    title: "We've got it from here",
    description: "Thanks — you'll hear back in under 60 seconds.",
    pathname: "/thank-you",
    noindex: true,
  }}
>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-4xl md:text-5xl">We've got it from here.</h1>
    <p class="mt-4 text-lg">
      You'll hear back in under 60 seconds between 8am and 9pm CT, or first thing in the morning.
    </p>
    <p class="mt-4 text-sm text-[color:var(--color-ink-500)]">
      Prefer to text us directly? {BRAND.phoneDisplay}.
    </p>
  </section>
  <script is:inline set:html={conversionScript} />
  {(metaPixelOn || adsSendTo) && <script is:inline set:html={pixelConversionScript} />}
</BaseLayout>
