---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Faq from "@components/Faq.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import ShingleStudio from "@components/design-center/ShingleStudio.tsx";
import RoofSystemDiagram from "@components/design-center/RoofSystemDiagram.tsx";
import RoofConfigurator from "@components/design-center/RoofConfigurator.tsx";
import { IKO_WARRANTY } from "~/lib/iko-products";
import { STUDIO_LINES } from "~/lib/design-studio";
import { faqPageJsonLd } from "~/lib/seo";
import { serviceLinks } from "~/lib/internal-links";

// Product structured data for the four lines (facts from design-studio.ts,
// sourced in docs/research-facts.md Sheet 1B).
const productLd = STUDIO_LINES.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: s.name,
  brand: { "@type": "Brand", name: "IKO" },
  category: "Roofing shingles",
  description: `${s.tagline} ${s.windShort} limited wind warranty, Limited Lifetime + ${s.ironCladYears}-year Iron Clad Protection.`,
  material: "Asphalt (fiberglass-reinforced)",
  additionalProperty: [
    { "@type": "PropertyValue", name: "Wind warranty", value: s.windShort },
    { "@type": "PropertyValue", name: "Iron Clad Protection", value: `${s.ironCladYears} years` },
    ...(s.impactLabel
      ? [{ "@type": "PropertyValue", name: "Impact rating", value: s.impactLabel }]
      : []),
  ],
}));

const faqs = [
  {
    q: "What's the difference between IKO Dynasty and IKO Nordic?",
    a: "Dynasty is our standard architectural shingle (UL 2218 Class 3). Nordic is the upgrade: polymer-modified (SBS) asphalt that earns the highest hail rating, UL 2218 Class 4. They share the ArmourZone nailing band, the 130-mph limited wind warranty, Limited Lifetime coverage, 15-year Iron Clad Protection, and the 10-year algae warranty.",
  },
  {
    q: "What's the difference between Cambridge and Dynasty?",
    a: "Cambridge is IKO's classic architectural shingle — the value pick with the traditional dimensional look. Dynasty adds the reinforced ArmourZone nailing band, a 130-mph wind warranty as standard (Cambridge is 110 mph, upgradable to 130 with IKO's high-wind installation), and 15 years of full Iron Clad coverage versus Cambridge's 10.",
  },
  {
    q: "What is Armourshake?",
    a: "Armourshake is IKO's Designer-collection shingle: an extra-heavyweight asphalt shingle cut in a random shake pattern for a hand-split cedar look without cedar's upkeep. It carries a Limited Lifetime warranty, 15-year Iron Clad Protection, the 10-year algae warranty, and a 110-mph wind warranty upgradable to 130 with IKO's high-wind installation.",
  },
  {
    q: "Is Class 4 (Nordic) worth the extra cost?",
    a: "Often, yes — but do the math first. Call your insurer and ask what annual premium discount a Class 4 roof earns you; over the life of the roof that discount frequently covers the upgrade. If your street sees repeated hail, the added durability is a bonus on top of the discount.",
  },
  {
    q: "Will my insurance company give me a discount for a Class 4 roof?",
    a: "Many Texas carriers offer a wind/hail premium credit for UL 2218 Class 4 roofs, and the Texas Department of Insurance notes Class 4 receives the highest available credit — but each company sets its own amount, and some offer none. Always confirm with your carrier before deciding.",
  },
  {
    q: "Does the impact rating mean my roof is hail-proof?",
    a: "No. IKO is explicit that the UL 2218 rating is a lab classification, not a guarantee against hail, and hail damage is not covered by the shingle warranty. Its purpose is to help you qualify for an insurance discount. No shingle is hail-proof.",
  },
  {
    q: "What is the ArmourZone?",
    a: "It's IKO's reinforced nailing band on Dynasty and Nordic — a wider, tougher, woven target for the fasteners. It gives installers a bigger margin for correct nail placement and helps the shingle resist the wind uplift that peels ordinary shingles.",
  },
  {
    q: "What wind warranty do IKO shingles carry?",
    a: "Dynasty and Nordic carry a 130-mph limited high-wind warranty when installed to IKO's application requirements — which is how we nail every Dynasty and Nordic roof. Cambridge and Armourshake carry 110 mph as standard, upgradable to 130 mph with IKO's documented high-wind installation (extra nails and sealed starter courses) — ask us to spec it for your roof.",
  },
  {
    q: "What is Iron Clad Protection?",
    a: "It's IKO's non-prorated coverage period: full coverage for manufacturing defects with no depreciation math, right through the window when a defect is most likely to show. It runs 15 years on Dynasty, Nordic, and Armourshake, and 10 years on Cambridge.",
  },
  {
    q: "How long should my IKO roof last?",
    a: "The product warranty is Limited Lifetime against manufacturing defects. Real-world service life depends on ventilation, install quality, and our climate — Gulf-Coast heat and UV shorten asphalt life, which is why we size ventilation on every job and offer free annual inspections.",
  },
  {
    q: "Which roof color is most popular in The Woodlands?",
    a: "Granite Black and Summit Grey are the most-requested here — both are versatile and read clean on almost any exterior. Weatherwood blends and Shadow Brown are popular on tan-brick and wooded lots. Your village's design-review palette has the final say.",
  },
  {
    q: "Does a darker roof make my house hotter?",
    a: "A darker roof absorbs more heat, but attic temperature is driven far more by ventilation than shingle color. We size balanced intake and exhaust on every replacement; a well-vented attic under a dark roof stays cooler than a poorly vented one under a light roof.",
  },
  {
    q: "Are the photos on this page exact color matches?",
    a: "Close, but treat them as previews: the images are IKO's own product photography, and granule color still shifts with production lot and lighting. We always bring physical samples in your candidate colors to the free estimate, so you're choosing off the actual product before you commit.",
  },
  {
    q: "Why don't you show every color IKO makes?",
    a: "We only publish imagery we can stand behind — IKO product photography for the colors homeowners here actually ask about. Every line offers more blends than we show on screen, and we bring the full physical sample deck to your estimate.",
  },
  {
    q: "What colors does Nordic come in?",
    a: "Nordic offers six colors: Olde Style Weatherwood, Granite Black, Shadow Brown, Summit Grey, Glacier, and Driftshake — all previewable above, and all muted enough for Woodlands covenant approval. Confirm your village palette before you commit.",
  },
  {
    q: "Will my HOA or the Township approve my color?",
    a: "The Woodlands Township requires prior written approval from your village's Residential Design Review Committee for any re-roof, and colors must be muted and harmonize with the landscape. We prepare and file that paperwork and bring compliant samples so your choice clears review the first time.",
  },
  {
    q: "What products are included in a complete IKO roof?",
    a: "Shingles (Cambridge, Dynasty, Nordic, or Armourshake), IKO Leading Edge Plus starter, Hip & Ridge cap, synthetic underlayment (RoofGard-Cool Grey / Stormtite), ice-and-water protector (ArmourGard / GoldShield / StormShield) in the vulnerable details, plus balanced ventilation and new flashing. The shingle is the visible part; the system is what lasts.",
  },
  {
    q: "How does Northvale install its roofing systems?",
    a: "Tear-off to the deck, deck inspection and replacement where needed, synthetic underlayment, ice-and-water at valleys and penetrations, new drip edge, pipe boots and flashing, and shingles nailed to IKO spec — six-nail patterns where wind exposure calls for it. Every layer is photographed in your 40-photo packet.",
  },
  {
    q: "Why does Northvale install IKO?",
    a: "IKO performs well in Southeast Texas: strong wind resistance via the ArmourZone on our standard lines, a Class 4 option for hail, reliable sealing, a straightforward warranty (Limited Lifetime + non-prorated Iron Clad + wind + 10-year algae), and a wide muted color range that fits our covenant communities — good long-term value without overpromising.",
  },
  {
    q: "Do you install anything other than IKO?",
    a: "We standardize on IKO shingles because it lets us master one system and stand behind it. For homeowners who want a non-asphalt roof, we also quote standing-seam and stone-coated metal, which the Township allows in non-glossy finishes.",
  },
  {
    q: "What's the algae warranty about?",
    a: "Gulf-Coast humidity causes blue-green algae streaking, worst on shaded, north-facing slopes. The IKO shingles we install carry a 10-year limited algae-resistance warranty. Never pressure-wash asphalt shingles — ARMA warns it causes damage.",
  },
  {
    q: "Can I get an extended (up to 25-year) Iron Clad warranty?",
    a: "IKO offers extended Iron Clad coverage only through higher ROOFPRO membership tiers. We're an IKO ROOFPRO applicant and won't advertise coverage we can't yet register — your estimate always states the exact warranty for your job in writing.",
  },
  {
    q: "How much does a new IKO roof cost?",
    a: "Every roof is priced from its own size, pitch, material, and decking condition — we put your exact price in writing before we leave. The line you choose (Cambridge to Armourshake) and any system upgrades set the price difference; the color you choose doesn't change it.",
  },
  {
    q: "Does color affect the price?",
    a: "No. Within a line, all colors are priced the same. The price difference is between the lines and any system upgrades you choose, not the color.",
  },
  {
    q: "How long does installation take?",
    a: "Most single-family roofs install in one day; larger or steep, complex homes take two. In The Woodlands the longer pole is covenant approval, which is why we file the RDRC application early.",
  },
  {
    q: "What if I'm not sure which color to pick?",
    a: "Flip through the studio above — seeing your shortlist on a real home narrows it fast. Then let us bring physical samples in your top choices; many homeowners decide at the estimate once they see the real shingle against their brick or siding.",
  },
  {
    q: "Can a Northvale rep help me choose?",
    a: "Absolutely — most homeowners decide with a rep. We'll walk the four lines and your candidate colors together, bring the real samples, and file the covenant paperwork once you've picked.",
  },
  {
    q: "What upgrades can I add to my roof?",
    a: "Common ones: stepping up to Nordic for Class 4 impact, upgraded ridge ventilation, extra ice-and-water coverage, and solar-ready flashing if panels are in your plans. The configurator lets you add these to your estimate request.",
  },
  {
    q: "Do you handle solar panels during a re-roof?",
    a: "Yes — we coordinate solar panel removal and reinstallation with trusted specialists, including on insurance-covered replacements. See our Humble project story for a real example.",
  },
  {
    q: "What happens after I submit my roof design?",
    a: "Your selection (shingle, color, and any upgrades) comes to us with your request, so we arrive prepared — with the right samples and a written estimate at a free inspection. You'll hear back in under 60 seconds during business hours.",
  },
  {
    q: "Can I change my selection later?",
    a: "Of course. The design you build here is a starting point for the conversation, not a contract. Nothing is final until you approve a written estimate.",
  },
];
---

<BaseLayout
  seo={{
    title: "Roof Design Center — Design Your IKO Roof | Northvale Roofing",
    description:
      "Explore four IKO shingle lines — Cambridge, Dynasty, Nordic, and Armourshake — in IKO's own photography, compare honest warranty terms, and build your roof. Then request a free inspection from Northvale Roofing.",
    pathname: "/roof-design-center",
    jsonLd: [...productLd, faqPageJsonLd(faqs)],
  }}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Roof Design Center" }]} />
    <h1 class="mt-6 text-4xl md:text-6xl">Design your roof</h1>
    <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-ink-800)]">
      Four IKO shingle lines, photographed by IKO. Pick a line, tap a color, and watch the roof
      change — then we bring your exact selection (and real samples) to a free inspection.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#studio" class="btn btn-primary">Explore the shingles</a>
      <a href="#build-your-roof" class="btn btn-ghost">Build your roof</a>
    </div>
  </section>

  <!-- 1. Shingle Studio -->
  <section id="studio" class="bg-[color:var(--color-navy-50)] py-12">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-3xl">The Shingle Studio</h2>
      <p class="mt-2 max-w-2xl text-[color:var(--color-ink-800)]">
        Cambridge, Dynasty, Nordic, and the Armourshake designer line — every color below is IKO's
        own photography of the real shingle.
      </p>
      <div class="mt-6">
        <ShingleStudio client:load />
      </div>
    </div>
  </section>

  <!-- 2. Compare -->
  <section id="compare" class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-3xl">Compare the four lines</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[720px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-[color:var(--color-navy-200)]">
            <th class="py-3 pr-4 font-semibold">&nbsp;</th>
            {STUDIO_LINES.map((s) => <th class="py-3 pr-4 font-semibold">{s.short}</th>)}
          </tr>
        </thead>
        <tbody
          class="[&_td]:border-b [&_td]:border-[color:var(--color-navy-100)] [&_td]:py-3 [&_td]:pr-4"
        >
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Collection</td>
            {STUDIO_LINES.map((s) => <td>{s.collection}</td>)}
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Product warranty</td>
            {STUDIO_LINES.map((s) => <td>{s.productWarranty}</td>)}
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Iron Clad (non-prorated)</td>
            {STUDIO_LINES.map((s) => <td>{s.ironCladYears} years</td>)}
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Wind warranty</td>
            {STUDIO_LINES.map((s) => <td>{s.windShort}</td>)}
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Impact rating (UL 2218)</td>
            {
              STUDIO_LINES.map((s) => (
                <td>{s.impactLabel ? <strong>{s.impactLabel}</strong> : "— ask us"}</td>
              ))
            }
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Algae warranty</td>
            {STUDIO_LINES.map((s) => <td>{s.algaeYears} years</td>)}
          </tr>
          <tr>
            <td class="text-[color:var(--color-ink-500)]">Best for</td>
            {STUDIO_LINES.map((s) => <td>{s.bestFor}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-[color:var(--color-ink-500)]">
      Warranty figures from IKO's Limited Warranty for asphalt shingles (US edition effective Feb 1,
      2025). Impact ratings are UL 2218 lab classifications, not hail guarantees — hail isn't
      covered by the shingle warranty; the rating exists to help you seek an insurance discount.
      "130 available" = IKO's documented high-wind installation.
    </p>
  </section>

  <!-- 3. Warranty center -->
  <section id="warranty" class="bg-[color:var(--color-navy-50)] py-12">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-3xl">Warranty, in plain language</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div
          class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5"
        >
          <h3 class="text-lg">Limited Lifetime product warranty</h3>
          <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">
            {IKO_WARRANTY.limitedLifetime}
          </p>
        </div>
        <div
          class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5"
        >
          <h3 class="text-lg">Iron Clad Protection</h3>
          <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">{IKO_WARRANTY.ironClad}</p>
        </div>
        <div
          class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5"
        >
          <h3 class="text-lg">Wind warranty</h3>
          <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">{IKO_WARRANTY.wind}</p>
        </div>
        <div
          class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5"
        >
          <h3 class="text-lg">10-year algae resistance</h3>
          <p class="mt-2 text-sm text-[color:var(--color-ink-800)]">{IKO_WARRANTY.algae}</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-[color:var(--color-ink-500)]">
        {IKO_WARRANTY.transfer} We're an IKO ROOFPRO applicant; IKO's extended Iron Clad coverage requires
        a higher ROOFPRO tier, so we don't advertise it until it's ours to register. Full detail on our
        <a class="underline" href="/warranty">warranty page</a>.
      </p>
    </div>
  </section>

  <!-- 4. Why IKO -->
  <section class="bg-[color:var(--color-navy-900)] py-12 text-white">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-3xl">Why we install IKO</h2>
      <p class="mt-4 text-white/85">
        We could stock a dozen brands and master none. Instead we standardize on IKO because it
        earns it in Southeast Texas: the reinforced ArmourZone holds up to Gulf-Coast wind, Nordic
        gives hail-exposed homes a true Class 4 option, the sealing technology is dependable in our
        heat, and the warranty is honest and easy to explain — Limited Lifetime, non-prorated Iron
        Clad, wind coverage, 10-year algae. The color range is wide enough to clear our covenant
        communities, and the value is strong without overpromising. Standardizing lets our crews
        install one system exceptionally well and stand behind it.
      </p>
    </div>
  </section>

  <!-- 5. Roof system diagram -->
  <section id="system" class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-3xl">Inside a complete IKO roof</h2>
    <p class="mt-2 max-w-2xl text-[color:var(--color-ink-800)]">
      Tap each layer to see what it does and what we install.
    </p>
    <div class="mt-6">
      <RoofSystemDiagram client:visible />
    </div>
  </section>

  <!-- 6. Build your roof -->
  <section id="build-your-roof" class="bg-[color:var(--color-navy-50)] py-12">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-3xl">Build your roof</h2>
      <p class="mt-2 text-[color:var(--color-ink-800)]">
        Five quick steps. Your selection comes to us with your request, so we arrive prepared.
      </p>
      <div class="mt-6">
        <RoofConfigurator client:load />
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h2 class="text-3xl">Roof Design Center FAQ</h2>
    <div class="mt-6">
      <Faq items={faqs} />
    </div>
  </section>

  <RelatedLinks heading="Explore our services" links={serviceLinks()} />
</BaseLayout>

<script>
  // Sync the hidden utm + conversion-event-id fields on every /api/lead form on
  // this page (the configurator posts here). Mirrors LeadForm's inline script so
  // Design Center leads keep full attribution + Meta dedup.
  (() => {
    const forms = document.querySelectorAll<HTMLFormElement>("form[action='/api/lead']");
    if (!forms.length) return;
    let payload: Record<string, string> = {};
    try {
      const saved = localStorage.getItem("nv_utm");
      const live = new URL(window.location.href);
      payload = saved ? JSON.parse(saved) : {};
      for (const k of [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "gclid",
        "fbclid",
      ]) {
        const v = live.searchParams.get(k);
        if (v) payload[k.replace(/^utm_/, "")] = v;
      }
      if (!payload.firstTouchAt) payload.firstTouchAt = new Date().toISOString();
      if (!payload.landingPath) payload.landingPath = live.pathname;
      localStorage.setItem("nv_utm", JSON.stringify(payload));
    } catch {
      /* no-op */
    }
    const eventId = "randomUUID" in crypto ? crypto.randomUUID() : "";
    if (eventId) {
      try {
        sessionStorage.setItem("nv_event_id", eventId);
      } catch {
        /* no-op */
      }
    }
    // The configurator hydrates after this runs, so also sync on submit.
    for (const form of forms) {
      form.addEventListener("submit", () => {
        const utm = form.querySelector<HTMLInputElement>("[data-utm-field]");
        const eid = form.querySelector<HTMLInputElement>("[data-event-id-field]");
        if (utm) utm.value = JSON.stringify(payload);
        if (eid && eventId) eid.value = eventId;
      });
    }
  })();
</script>
