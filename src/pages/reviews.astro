---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteReviews } from "~/lib/reviews";
import { getPublishedProjects } from "~/lib/projects";
import { aggregateRatingJsonLd } from "~/lib/seo";

// Admin-managed reviews (added via the /keystatic panel) + live Google reviews
// (when GOOGLE_PLACES_API_KEY + GOOGLE_PLACE_ID are set). Real reviews only —
// placeholder/seed entries are filtered out in getSiteReviews.
const reviews = await getSiteReviews();
// While there are zero reviews, the page features the real documented project
// stories instead of sitting empty — honest proof until reviews arrive.
const projects = await getPublishedProjects();

const siteUrl = Astro.site?.toString() ?? "https://northvaleroofing.com";
// null while there are zero real reviews — never emitted fabricated.
const aggregateRating = aggregateRatingJsonLd(siteUrl, reviews);

// Quality gate: stays noindex (and meta stays neutral) until real reviews
// exist — the title/description must never assert reviews that don't.
const hasReviews = reviews.length > 0;
---

<BaseLayout
  seo={{
    title: hasReviews ? "Reviews from Woodlands + Spring neighbors" : "Reviews — Northvale Roofing",
    description: hasReviews
      ? "Verified Google and direct customer reviews from homeowners across The Woodlands, Spring, Tomball, Magnolia, Conroe, and Cypress."
      : "Customer reviews will be published here as jobs close. We only ever publish real reviews.",
    pathname: "/reviews",
    noindex: !hasReviews,
    ...(aggregateRating ? { jsonLd: aggregateRating } : {}),
  }}
>
  <section class="page-header-band mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl">Reviews</h1>
    <div class="rule-gold mt-6" aria-hidden="true"></div>
    <p class="mt-3 text-lg text-[color:var(--color-ink-500)]">
      Verified Google reviews plus direct customer reviews added after job close. We only ever
      publish real reviews.
    </p>
    {
      reviews.length === 0 ? (
        <div class="mt-10">
          <p class="max-w-2xl text-[color:var(--color-ink-700)]">
            We're a young company and our first reviews are on their way. Until they land, don't
            take our word for anything — read what actually happened on real jobs, documented start
            to finish:
          </p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {projects.map((p) => (
              <a
                href={`/projects/${p.id}`}
                class="group grid content-start overflow-hidden rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white no-underline transition duration-200 hover:-translate-y-0.5 hover:border-[color:var(--color-navy-300)] hover:shadow-[var(--shadow-card-hover)]"
              >
                {p.data.photo && (
                  <div class="overflow-hidden" style="aspect-ratio:16/9;">
                    <img
                      src={p.data.photo.src}
                      alt={p.data.photo.alt}
                      loading="lazy"
                      decoding="async"
                      class="block h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="grid gap-2 p-6">
                  <p class="text-[11px] font-semibold tracking-[0.18em] text-[color:var(--color-gold-600)] uppercase">
                    {p.data.area} · Documented job
                  </p>
                  <h2 class="text-xl">{p.data.title}</h2>
                  <p class="text-sm leading-relaxed text-[color:var(--color-ink-700)]">
                    {p.data.shortStory}
                  </p>
                  <span class="mt-1 text-sm font-semibold text-[color:var(--color-navy-700)] group-hover:text-[color:var(--color-gold-600)]">
                    Read the full story →
                  </span>
                </div>
              </a>
            ))}
          </div>
          <p class="mt-8 max-w-2xl text-sm text-[color:var(--color-ink-500)]">
            Google reviews sync here automatically once our Business Profile is live, and direct
            customer reviews are added as jobs close — always real, never edited.
          </p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {reviews.map((r) => (
            <article class="rounded-[var(--radius-card)] bg-white p-6 shadow-[var(--shadow-card)]">
              <p>{r.text}</p>
              <p class="mt-4 font-semibold">{r.author}</p>
              <p class="text-xs text-[color:var(--color-ink-500)]">
                {r.source} · {r.relativeTime}
              </p>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
