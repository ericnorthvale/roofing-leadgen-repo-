---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import LeadForm from "@components/LeadForm.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import { BRAND } from "~/lib/brand";
import { IKO_WARRANTY } from "~/lib/iko-products";
import { serviceLinks } from "~/lib/internal-links";

const certStatus = BRAND.certStatus || "IKO ROOFPRO applicant";
---

<BaseLayout
  seo={{
    title: "Certifications & Manufacturer Status — Honest, Verifiable",
    description:
      "Where Northvale Roofing actually stands: our IKO ROOFPRO status, the IKO warranties we register on every job, and the coverage we won't advertise until it's ours to offer.",
    pathname: "/certifications",
  }}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Certifications" }]} />
    <h1 class="mt-6 text-4xl md:text-5xl">Certifications, stated honestly</h1>
    <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-ink-800)]">
      Roofing is full of badge inflation. Here's exactly where we stand — what we hold, what we're
      earning, and what we won't claim until it's genuinely ours to offer.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-6 md:grid-cols-[1fr_400px]">
    <article class="prose-northvale">
      <h2>Manufacturer: IKO</h2>
      <p>
        We standardize on IKO roofing systems. Our current status is <strong>{certStatus}</strong> — we're
        enrolling in IKO's ROOFPRO contractor program, and we'll state our exact tier here once it's confirmed.
        We won't display a ROOFPRO tier we don't hold.
      </p>

      <h2>The IKO coverage we register on every job</h2>
      <p>These are warranties any qualified installer can register — and we do, on every roof:</p>
      <ul>
        <li>{IKO_WARRANTY.limitedLifetime}</li>
        <li>{IKO_WARRANTY.ironClad}</li>
        <li>{IKO_WARRANTY.wind}</li>
        <li>{IKO_WARRANTY.algae}</li>
      </ul>

      <h2>What we're <em>not</em> claiming yet</h2>
      <p>
        IKO's longest coverage — Iron Clad Extended Protection, up to 25 years depending on shingle
        type — is only available through higher ROOFPRO membership tiers. Until our membership is
        confirmed at the level that unlocks it, we will not advertise or sell that extended
        coverage. When it changes, this page changes. Your written estimate always states the exact
        warranty for your job.
      </p>

      <h2>Licensing in Texas</h2>
      <p>{BRAND.licenseNote}</p>

      <h2>How we prove our work</h2>
      <p>
        Certifications are one signal; documentation is a better one. Every Northvale job produces a
        forty-photo record of the roof — before, during, and after — with a named project manager on
        site. See real completed jobs in our <a href="/projects">homeowner stories</a>, and how the
        full IKO system goes together in the <a href="/roof-design-center">Roof Design Center</a>.
      </p>
      <p>
        For the full breakdown of what each warranty covers, read
        <a href="/warranty">roof warranties, explained honestly</a>.
      </p>
    </article>
    <aside class="md:sticky md:top-10 md:self-start">
      <LeadForm source="certifications-page" />
    </aside>
  </section>

  <RelatedLinks heading="Our services" links={serviceLinks()} />
</BaseLayout>
