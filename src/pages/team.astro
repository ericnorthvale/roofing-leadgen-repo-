---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import LeadForm from "@components/LeadForm.astro";
import ImagePlaceholder from "@components/ImagePlaceholder.astro";

// Quality gate: stays noindex until real team members (names, roles, photos)
// are supplied by the owner. NEVER invent people (FTC + Hard Rule #2).
const hasRealTeam = false;
---

<BaseLayout
  seo={{
    title: "Meet the Northvale Roofing Team",
    description:
      "The people behind Northvale Roofing — project managers, crews, and the standards they work to on every Houston-area roof.",
    pathname: "/team",
    noindex: !hasRealTeam,
  }}
>
  {
    !hasRealTeam && (
      <div class="border-b-2 border-[color:var(--color-gold-400)] bg-[color:var(--color-gold-50)] px-4 py-3 text-sm text-[color:var(--color-ink-800)]">
        <div class="mx-auto max-w-6xl">
          <strong>NEEDS REAL DATA — draft, not indexed.</strong> This page publishes once real team
          members (names, roles, photos) are added. Inventing people is prohibited — see
          TASKS_FOR_ERIC.md.
        </div>
      </div>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Our team" }]} />
    <h1 class="mt-6 text-4xl md:text-5xl">The people on your roof</h1>
    <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-ink-800)]">
      A named project manager on every job means names you can actually meet. Here's who answers
      when you call.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[1fr_400px]">
    <article class="prose-northvale">
      <h2>[NEEDS DATA: team members]</h2>
      <p>
        <em>
          Each teammate gets a real name, role, photo, and background — added by the owner. No
          stock-photo "teams," no invented bios.
        </em>
      </p>
      <div class="not-prose mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
        <ImagePlaceholder
          slot="TEAM: owner/operator portrait"
          alt="Northvale Roofing owner portrait"
          ratio="3/4"
          tone="navy"
        />
        <ImagePlaceholder
          slot="TEAM: project manager portrait"
          alt="Northvale Roofing project manager portrait"
          ratio="3/4"
          tone="mixed"
        />
        <ImagePlaceholder
          slot="TEAM: crew lead portrait"
          alt="Northvale Roofing crew lead portrait"
          ratio="3/4"
          tone="gold"
        />
      </div>
      <h2>The standards everyone works to</h2>
      <ul>
        <li>Same-day inspection, written estimate before we leave the driveway.</li>
        <li>A named project manager with a cell number — not a dispatcher.</li>
        <li>Forty-photo documentation on every job.</li>
        <li>Manufacturer-spec installation, warranty registered at close-out.</li>
        <li>No door-knocking, no pressure signings, no deductible games — ever.</li>
      </ul>
      <p>
        Read <a href="/process">how a job runs end to end</a>, or
        <a href="/about"> why we built Northvale</a>.
      </p>
    </article>
    <aside class="md:sticky md:top-10 md:self-start">
      <LeadForm source="team-page" />
    </aside>
  </section>
</BaseLayout>
