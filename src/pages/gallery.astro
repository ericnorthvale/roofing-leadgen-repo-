---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import PhotoGallery from "@components/PhotoGallery.astro";
import LeadForm from "@components/LeadForm.astro";
import { getPublishedProjects } from "~/lib/projects";

// Real Northvale project photos, sourced from the published project stories
// (single source of truth). Presenting stock imagery as our work would violate
// FTC rules (Hard Rule #2), so this only ever shows real jobs.
const photos = (await getPublishedProjects())
  .filter((p) => p.data.photo)
  .map((p) => ({ url: p.data.photo!.src, alt: p.data.photo!.alt }));
const hasRealPhotos = photos.length > 0;
---

<BaseLayout
  seo={{
    title: "Project Gallery — Our Work",
    description:
      "Completed roof replacements and repairs by Northvale Roofing across The Woodlands and NW Houston — documented start to finish.",
    pathname: "/gallery",
    noindex: !hasRealPhotos,
  }}
>
  {
    !hasRealPhotos && (
      <div class="border-b-2 border-[color:var(--color-gold-400)] bg-[color:var(--color-gold-50)] px-4 py-3 text-sm text-[color:var(--color-ink-800)]">
        <div class="mx-auto max-w-6xl">
          <strong>NEEDS REAL DATA — draft, not indexed.</strong> This page publishes when real
          Northvale project photos land (CompanyCam → owner review). Stock imagery must never be
          presented as our work.
        </div>
      </div>
    )
  }

  <section class="page-header-band mx-auto max-w-6xl px-4 py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Gallery" }]} />
    <h1 class="mt-6 text-4xl md:text-5xl">Our work, documented</h1>
    <div class="rule-gold mt-6" aria-hidden="true"></div>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-700)]">
      Every Northvale job produces a forty-photo record — this gallery fills with those photos, from
      our own local projects, as they complete. Never stock imagery.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6">
    {/* Real job photos from the published project stories. */}
    <PhotoGallery photos={photos} />
    {
      hasRealPhotos && (
        <p class="mt-6 text-center">
          <a class="font-semibold underline" href="/projects">
            Read the stories behind these roofs →
          </a>
        </p>
      )
    }
  </section>

  <section class="mx-auto max-w-xl px-4 py-12">
    <LeadForm source="gallery-page" />
  </section>
</BaseLayout>
