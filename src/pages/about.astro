---
import BaseLayout from "@layouts/BaseLayout.astro";
import CTAButton from "@components/CTAButton.astro";
import ImagePlaceholder from "@components/ImagePlaceholder.astro";
import { BRAND } from "~/lib/brand";
---

<BaseLayout
  seo={{
    title: "About Northvale Roofing",
    description:
      "Why we built Northvale Roofing: same-day inspections, written estimates before we leave the driveway, and a named project manager on every job.",
    pathname: "/about",
  }}
>
  <section class="page-header-band mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl md:text-5xl">
      We built Northvale because we were tired of how roofing usually goes.
    </h1>
    <div class="rule-gold mt-6" aria-hidden="true"></div>
    <article class="prose-northvale mt-8">
      <p>
        Most roofing sales look the same: a stranger in a truck, a verbal number, a pressure close
        before the neighbor next door signs with someone else. The homeowner ends up either
        overpaying for what they got, or underpaying for something that fails in year seven.
      </p>
      <p>
        We built {BRAND.name} to do it the way we'd want it done to our own houses. <strong
          >Same-day inspection. Written estimate before we leave the driveway. A named project
          manager on every job.</strong
        > No dispatcher, no "one of our team members will reach out."
      </p>
      <h2>What you get</h2>
      <ul>
        <li>A 10+ year foreman on every crew — not a first-week helper running a nail gun.</li>
        <li>
          A forty-photo documentation packet at job close. It's yours; we also send a copy to your
          insurance file.
        </li>
        <li>
          IKO Dynasty as the default — a Limited Lifetime product warranty, IKO's 15-year
          non-prorated Iron Clad Protection, and a 130-mph limited high-wind warranty. Registered to
          you at close, with IKO Nordic's Class 4 impact upgrade quoted alongside it.
        </li>
        <li>
          <!-- NEEDS DATA: confirm crew model (W-2 vs. vetted subs) with owner — see TASKS_FOR_ERIC.md -->
          Every job — whether run by our crew or a vetted partner crew — is led by a 10+ year foreman
          and signed off by a named Northvale project manager.
        </li>
      </ul>
      <h2>What we won't do</h2>
      <ul>
        <li>
          We don't knock doors after a storm. TDI publishes contractor-scam warnings because of what
          happens on those doorsteps — and more importantly, it's how neighbors get burned.
        </li>
        <li>
          We don't waive deductibles. It's a criminal offense in Texas (Bus. & Com. Code § 27.02) —
          not a gray area.
        </li>
        <li>
          We don't bid against $7K full-replacement numbers. If that's the price you need, we're not
          your roofer. We'll happily tell you what's missing in that bid.
        </li>
      </ul>
    </article>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <ImagePlaceholder
        slot="CREW: foreman / named project manager"
        alt="Northvale Roofing foreman on a job site"
        demoKey="crew-foreman"
        ratio="3/2"
        tone="navy"
      />
      <ImagePlaceholder
        slot="CREW: team installing a roof"
        alt="Northvale Roofing crew installing a new roof"
        demoKey="crew-install"
        ratio="3/2"
        tone="mixed"
      />
      <ImagePlaceholder
        slot="TRUCK: branded Northvale vehicle"
        alt="Branded Northvale Roofing truck on a local street"
        demoKey="truck"
        ratio="3/2"
        tone="gold"
      />
    </div>

    <div class="mt-10 flex gap-3">
      <CTAButton href="/contact" label="Book my inspection" ctaId="about-book" />
      <CTAButton href="/reviews" variant="ghost" label="Read reviews" />
    </div>
  </section>
</BaseLayout>
