<style is:global>
  /* Reveal styles engage ONLY when JS adds .nv-anim to <html> — crawlers and
     no-JS users always see the full page. (Shared convention with the
     homepage climate section.) */
  html.nv-anim .nv-anim-item {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
  }
  html.nv-anim .nv-anim-item.is-in {
    opacity: 1;
    transform: none;
  }
  html.nv-anim .nv-vow {
    transition-delay: var(--vow-delay, 0ms);
  }
  /* The gold check draws itself when its card reveals. */
  html.nv-anim .nv-check-path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 0.5s ease 0.35s;
  }
  html.nv-anim .nv-anim-item.is-in .nv-check-path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    html.nv-anim .nv-anim-item,
    html.nv-anim .nv-vow {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html.nv-anim .nv-check-path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  // Progressive enhancement only — see the SEO contract in the frontmatter.
  document.documentElement.classList.add("nv-anim");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        const count = e.target.querySelector<HTMLElement>("[data-countup]");
        if (count && !count.dataset.done) {
          count.dataset.done = "1";
          startCount(count);
        }
        io.unobserve(e.target);
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll(".nv-anim-item").forEach((el) => io.observe(el));

  function startCount(el: HTMLElement) {
    const target = parseFloat(el.dataset.countup ?? "");
    if (!Number.isFinite(target) || reduced) return;
    const t0 = performance.now();
    const dur = 1100;
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
