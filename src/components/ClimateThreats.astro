---
/**
 * "Why roofs fail in The Woodlands" — the interactive climate-threat index.
 *
 * SEO CONTRACT: every word is server-rendered in the initial HTML. The
 * interactivity (hotspot highlighting, count-up numbers, scroll reveals,
 * mobile snap-scroll) is progressive enhancement layered on top — with JS
 * disabled the section is a fully readable, fully crawlable set of headed
 * cards. The reveal styles only engage when JS adds `nv-anim` to <html>, so
 * nothing is ever hidden from crawlers or no-JS users. `prefers-reduced-motion`
 * disables all movement.
 *
 * FACTS: every figure/claim is carried over from the previously published,
 * sourced homepage copy (docs/research-facts.md Sheet 3 — NOAA, ARMA, IBHS,
 * NWS, IRC, Township covenants). The "what it looks like" lines are standard
 * field diagnostics (editorial, allowed). Local terms (Montgomery County,
 * Shenandoah, Conroe, Spring, Harris County, Southeast Texas, Gulf Coast) are
 * used only where factually earned — no other page's primary query is targeted
 * (docs/keyword-map.md: one primary query per page).
 */

interface Threat {
  id: string;
  n: string;
  title: string;
  /** Big display value. Either a count-up number + suffix, or display text. */
  stat?: { value: string; suffix: string; label: string };
  statText?: { value: string; label: string };
  body: string;
  tell: string;
}

const THREATS: Threat[] = [
  {
    id: "threat-heat",
    n: "01",
    title: "Heat & UV — the Texas attic oven",
    stat: { value: "140", suffix: "°F", label: "a poorly-vented attic on a 90° day (ARMA)" },
    body: "NOAA's climate normals put July and August highs near 94–95°F here, and the Asphalt Roofing Manufacturers Association warns a poorly-ventilated attic can reach 140°F on a 90-degree day — cooking the asphalt binder in your shingles from below. Once protective granules displace, IBHS research shows the exposed asphalt embrittles and ages faster. Heat is the quiet failure mode — no storm required.",
    tell: "Curling shingle edges, granules collecting in gutters, shingles that crack instead of flex.",
  },
  {
    id: "threat-hail",
    n: "02",
    title: "Hail across Montgomery County",
    stat: { value: "1", suffix: "″", label: "hail near Shenandoah, June 2025 (NOAA)" },
    body: "NOAA's Storm Events Database records damaging hail — ¾-inch or larger — somewhere in Montgomery County nearly every year; one-inch hail fell near Shenandoah as recently as June 2025. IBHS impact research adds a subtler point: repeated small hail plus normal weathering can make shingles perform like decade-older material, so a roof can be storm-weakened without one dramatic event.",
    tell: "Soft dark bruises in the shingle mat, dented vents and gutters — often invisible from the driveway.",
  },
  {
    id: "threat-wind",
    n: "03",
    title: "Wind — Gulf storms to I-45 downbursts",
    stat: {
      value: "69",
      suffix: " mph",
      label: "Hurricane Beryl's gust measured at Conroe (2024)",
    },
    body: "The National Weather Service counts 50–60 thunderstorm days a year across Southeast Texas — a third of them severe — with downbursts driving 60 to 100+ mph winds. Tropical systems reach far inland too: Hurricane Beryl (2024) produced a measured 69-mph gust at Conroe. What actually fails in wind, per IBHS, is the sealant bond between shingles, and that bond weakens with age.",
    tell: "Creased, lifted, or missing shingle tabs along ridges and roof edges after a storm.",
  },
  {
    id: "threat-algae",
    n: "04",
    title: "Humidity & algae streaking on Gulf Coast roofs",
    statText: { value: "No. 1", label: "roof-discoloration species in the Gulf States (ARMA)" },
    body: "The black streaks on roofs from The Woodlands to Spring are Gloeocapsa magma — the algae ARMA identifies as the most prevalent roof-discoloration species, most widespread in the Gulf States. The stains don't destroy shingles by themselves, but the shade and moisture patterns that feed them also slow drying — and never pressure-wash them off; ARMA warns pressure washing damages asphalt roofing.",
    tell: "Black streaks running down shaded, north-facing slopes.",
  },
  {
    id: "threat-pine",
    n: "05",
    title: "Pine needles & The Woodlands' canopy",
    statText: { value: "The Forest", label: "the working load on every Woodlands roof" },
    body: "The forest is the whole point of The Woodlands — and a working load on its roofs. Needles and leaves pack into valleys and gutters, hold moisture against shingles, and back water up under the roof edge. The Township's own covenants require owners to keep roofs clear of leaves, needles, and branches; extension-service guidance adds trimming limbs that overhang the roof.",
    tell: "Needle mats in the valleys, overflowing gutters, damp shade lines across the slope.",
  },
  {
    id: "threat-rain",
    n: "06",
    title: "Heavy rain & flashing failures",
    stat: { value: "25.66", suffix: "″", label: "of rain Harvey dropped on The Woodlands (2017)" },
    body: "Annual rainfall runs near 50 inches here — and in 2017, Harvey dropped 25.66 inches on The Woodlands in days. Water finds the weak detail, and the weak detail is usually flashing: the code's entire purpose for it is keeping moisture out of roof and wall joints (IRC R903.2). Aged step flashing, cracked pipe boots (the rubber commonly fails within 10–15 years), and nail pops are the leaks we chase most.",
    tell: "Ceiling stains after hard rain, cracked rubber at pipe boots, rust lines where roof meets wall.",
  },
];

// Hotspot markers sit ON the drawn phenomenon (viewBox 860x420) and carry a
// matching icon; the same glyph repeats on each threat card so the pairing
// is instant. Positions are percentages of the diagram box.
const HOTSPOTS: { id: string; x: number; y: number; name: string }[] = [
  { id: "threat-heat", x: 47.7, y: 32.9, name: "Heat shimmer at the ridge" },
  { id: "threat-hail", x: 38.4, y: 39.5, name: "Hail striking the shingles" },
  { id: "threat-wind", x: 30, y: 50, name: "Wind lifting the roof edge" },
  { id: "threat-algae", x: 57.2, y: 41, name: "Algae streaks on the shaded slope" },
  { id: "threat-rain", x: 61.7, y: 46.7, name: "Rain at the chimney flashing" },
  { id: "threat-pine", x: 76.2, y: 59.5, name: "Pine needles falling into the valley" },
];

/** Inline icon glyphs (24x24, stroke = currentColor) shared by markers + cards. */
const GLYPHS: Record<string, string> = {
  "threat-heat":
    '<path d="M10 4a2 2 0 0 1 4 0v9.5a4.5 4.5 0 1 1-4 0z"/><line x1="12" y1="8" x2="12" y2="15"/>',
  "threat-hail":
    '<circle cx="12" cy="15" r="4"/><line x1="8" y1="3.5" x2="9.5" y2="7.5"/><line x1="15" y1="3.5" x2="14" y2="7.5"/>',
  "threat-wind":
    '<path d="M3 8h9a2.5 2.5 0 1 0-2.5-2.5"/><path d="M3 13h13a2.5 2.5 0 1 1-2.5 2.5"/><path d="M3 18h7"/>',
  "threat-algae":
    '<path d="M7 4q3 4 0 8t0 8"/><path d="M12 4q3 4 0 8t0 8"/><path d="M17 4q3 4 0 8t0 8"/>',
  "threat-pine": '<path d="M12 3L7 10h3l-4 6h4l-3 5h10l-3-5h4l-4-6h3z"/>',
  "threat-rain": '<path d="M12 4c3.2 4.3 5.5 7 5.5 10a5.5 5.5 0 1 1-11 0c0-3 2.3-5.7 5.5-10z"/>',
};

const glyphSvg = (id: string, cls: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${GLYPHS[id]}</svg>`;
---

<div class="pt-2">
  <h2 id="why-roofs-fail" class="text-3xl md:text-4xl">Why roofs fail in The Woodlands</h2>
  <div class="rule-gold mt-5" aria-hidden="true"></div>
  <p class="mt-6 max-w-3xl text-lg leading-relaxed text-[color:var(--color-ink-700)]">
    Roofs don't fail randomly here — they fail on a schedule written by this climate. Knowing the
    failure modes is how you catch them at repair price instead of replacement price.
  </p>

  {/* Sourced climate stat strip */}
  <dl
    class="mt-8 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-[color:var(--color-navy-100)] sm:grid-cols-3"
  >
    {
      [
        ["50–60", "thunderstorm days a year in Southeast Texas (NWS)"],
        ["~50 in", "of rain on Montgomery County roofs annually"],
        ["94–95°F", "average July–August highs (NOAA)"],
      ].map(([v, l]) => (
        <div class="bg-white px-5 py-4 text-center">
          <dt class="sr-only">{l}</dt>
          <dd>
            <span class="font-serif text-[30px] leading-none text-[color:var(--color-navy-900)]">
              {v}
            </span>
            <span class="mt-1.5 block text-xs leading-snug text-[color:var(--color-ink-500)]">
              {l}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  {/* Interactive diagram — navigation & delight only; all content lives in the cards below */}
  <div
    id="roof-diagram"
    class="nv-anim-item nv-diagram relative mx-auto mt-10 hidden max-w-3xl sm:block"
  >
    <svg
      viewBox="0 0 860 420"
      class="w-full"
      role="img"
      aria-label="Line drawing of a Woodlands-style home with each climate threat drawn where it attacks: hail falling on the shingles, wind at the roof edge, algae streaks on the shaded slope, rain at the chimney flashing, pine needles dropping into the valley, and heat shimmer at the ridge"
    >
      <g
        fill="none"
        stroke="var(--color-navy-300)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- ground -->
        <line x1="40" y1="380" x2="820" y2="380" stroke="var(--color-navy-200)"></line>

        <!-- main house -->
        <rect x="280" y="212" width="310" height="168"></rect>
        <polyline points="255,214 435,105 615,214" stroke="var(--color-navy-900)" stroke-width="3"
        ></polyline>
        <rect x="315" y="252" width="44" height="44"></rect>
        <rect x="408" y="252" width="44" height="44"></rect>
        <rect x="501" y="252" width="44" height="44"></rect>
        <rect x="408" y="320" width="44" height="60"></rect>

        <!-- garage + the valley where it meets the house -->
        <rect x="590" y="272" width="140" height="108"></rect>
        <polyline points="590,272 660,220 730,272" stroke="var(--color-navy-900)" stroke-width="3"
        ></polyline>
        <rect x="612" y="308" width="96" height="72"></rect>

        <!-- chimney (rain / flashing joint) -->
        <rect x="516" y="134" width="30" height="54" stroke="var(--color-navy-900)"></rect>

        <!-- 01 · heat: sun + shimmer rising off the ridge -->
        <g stroke="var(--color-gold-500)">
          <circle cx="95" cy="64" r="22"></circle>
          <line x1="95" y1="22" x2="95" y2="32"></line>
          <line x1="95" y1="96" x2="95" y2="106"></line>
          <line x1="53" y1="64" x2="63" y2="64"></line>
          <line x1="127" y1="64" x2="137" y2="64"></line>
          <line x1="65" y1="34" x2="72" y2="41"></line>
          <line x1="118" y1="87" x2="125" y2="94"></line>
          <path d="M392 160 q5 -9 0 -18 q-5 -9 0 -18"></path>
          <path d="M412 152 q5 -9 0 -18 q-5 -9 0 -18"></path>
          <path d="M432 146 q5 -9 0 -18 q-5 -9 0 -18"></path>
        </g>

        <!-- 02 · hail: cloud, falling stones, impact burst on the slope -->
        <circle cx="278" cy="56" r="14"></circle>
        <circle cx="298" cy="46" r="18"></circle>
        <circle cx="320" cy="56" r="14"></circle>
        <line x1="264" y1="70" x2="334" y2="70"></line>
        <g stroke="var(--color-navy-400)">
          <circle cx="302" cy="95" r="4"></circle>
          <circle cx="312" cy="115" r="3.5"></circle>
          <circle cx="320" cy="135" r="4"></circle>
          <circle cx="327" cy="152" r="3"></circle>
          <line x1="322" y1="160" x2="316" y2="152"></line>
          <line x1="331" y1="158" x2="331" y2="149"></line>
          <line x1="340" y1="162" x2="346" y2="155"></line>
        </g>

        <!-- 03 · wind: gusts driving at the eave, one lifted shingle tab -->
        <g stroke="var(--color-navy-400)" stroke-width="2.5">
          <path d="M70 186 q55 -12 118 -2"></path>
          <path d="M56 208 q70 -14 152 -4"></path>
          <path d="M74 230 q60 -10 130 -4"></path>
        </g>
        <polyline points="248,210 260,200 268,206" stroke="var(--color-navy-900)" stroke-width="3"
        ></polyline>

        <!-- 04 · algae: dark streaks running down the shaded slope -->
        <g stroke="var(--color-navy-400)" stroke-width="2.5" opacity="0.55">
          <path d="M455 130 q9 11 5 22 q-3 9 7 20"></path>
          <path d="M477 143 q9 11 5 22 q-3 9 7 20"></path>
          <path d="M499 156 q9 11 5 22 q-3 9 7 18"></path>
          <path d="M521 169 q8 10 5 20 q-2 8 6 16"></path>
        </g>

        <!-- 05 · rain: cloud over the chimney, drops, drip at the flashing -->
        <circle cx="560" cy="44" r="13"></circle>
        <circle cx="578" cy="36" r="16"></circle>
        <circle cx="597" cy="44" r="13"></circle>
        <line x1="547" y1="57" x2="610" y2="57"></line>
        <g stroke="var(--color-navy-400)">
          <line x1="556" y1="72" x2="550" y2="88"></line>
          <line x1="578" y1="70" x2="572" y2="88"></line>
          <line x1="600" y1="74" x2="594" y2="90"></line>
          <path d="M522 194 q5 7 10 0"></path>
        </g>

        <!-- 06 · pine: canopy overhanging the garage, needles into the valley -->
        <polygon points="792,148 746,222 838,222"></polygon>
        <polygon points="792,190 736,272 848,272"></polygon>
        <polygon points="792,235 726,318 858,318"></polygon>
        <line x1="792" y1="318" x2="792" y2="380"></line>
        <g stroke="var(--color-navy-400)">
          <line x1="738" y1="256" x2="744" y2="264"></line>
          <line x1="718" y1="268" x2="726" y2="272"></line>
          <line x1="700" y1="256" x2="704" y2="265"></line>
          <line x1="684" y1="268" x2="692" y2="272"></line>
          <line x1="668" y1="258" x2="672" y2="267"></line>
        </g>
      </g>
    </svg>
    {
      HOTSPOTS.map((h) => (
        <button
          type="button"
          data-hotspot={h.id}
          aria-label={`${h.name} — jump to the matching threat`}
          class="nv-hotspot absolute grid h-9 w-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-[color:var(--color-gold-400)] text-[color:var(--color-navy-950)] shadow-[var(--shadow-card)] transition hover:scale-110"
          style={`left:${h.x}%; top:${h.y}%`}
          set:html={glyphSvg(h.id, "h-4.5 w-4.5")}
        />
      ))
    }
    <p class="mt-1 text-center text-xs tracking-wide text-[color:var(--color-ink-500)]">
      Every marker sits on the threat it describes — tap one to read what it does to your roof.
    </p>
  </div>

  {/* The six threats — swipeable deck on phones, grid from md up */}
  <ol
    class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:overflow-visible md:pb-0 xl:grid-cols-3"
  >
    {
      THREATS.map((t, i) => (
        <li
          id={t.id}
          tabindex="-1"
          class="nv-anim-item nv-threat min-w-[85%] snap-center rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-6 transition duration-300 outline-none md:min-w-0"
        >
          <div class="flex items-baseline justify-between gap-3">
            <span class="flex items-center gap-2 text-[11px] font-bold tracking-[0.2em] text-[color:var(--color-gold-600)]">
              <span class="nv-glyph inline-flex" set:html={glyphSvg(t.id, "h-4 w-4")} />
              {t.n}
            </span>
            {t.stat ? (
              <p class="text-right">
                <span class="font-serif text-[38px] leading-none text-[color:var(--color-navy-900)]">
                  <span data-countup={t.stat.value}>{t.stat.value}</span>
                  <span class="text-[color:var(--color-gold-600)]">{t.stat.suffix}</span>
                </span>
                <span class="mt-1 block max-w-[220px] text-[11px] leading-snug text-[color:var(--color-ink-500)]">
                  {t.stat.label}
                </span>
              </p>
            ) : (
              <p class="text-right">
                <span class="font-serif text-[30px] leading-none text-[color:var(--color-navy-900)] italic">
                  {t.statText!.value}
                </span>
                <span class="mt-1 block max-w-[220px] text-[11px] leading-snug text-[color:var(--color-ink-500)]">
                  {t.statText!.label}
                </span>
              </p>
            )}
          </div>
          <h3 class="mt-4 text-lg leading-snug">{t.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-[color:var(--color-ink-700)]">{t.body}</p>
          <details class="mt-4 border-t border-[color:var(--color-navy-100)] pt-3">
            <summary class="cursor-pointer text-sm font-semibold text-[color:var(--color-gold-600)]">
              What it looks like on your roof
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-700)]">{t.tell}</p>
          </details>
          <div class="mt-4 flex items-center justify-between gap-3 border-t border-[color:var(--color-navy-100)] pt-3 text-xs font-semibold tracking-[0.12em] uppercase">
            <button
              type="button"
              data-goto={THREATS[(i + THREATS.length - 1) % THREATS.length].id}
              aria-label={`Previous threat: ${THREATS[(i + THREATS.length - 1) % THREATS.length].title}`}
              class="cursor-pointer text-[color:var(--color-ink-500)] transition-colors hover:text-[color:var(--color-navy-900)]"
            >
              ← Prev
            </button>
            <a
              href="#roof-diagram"
              data-to-diagram
              class="hidden text-[color:var(--color-gold-600)] no-underline hover:text-[color:var(--color-gold-700)] sm:inline"
            >
              ↑ House diagram
            </a>
            <button
              type="button"
              data-goto={THREATS[(i + 1) % THREATS.length].id}
              aria-label={`Next threat: ${THREATS[(i + 1) % THREATS.length].title}`}
              class="cursor-pointer text-[color:var(--color-navy-900)] transition-colors hover:text-[color:var(--color-gold-600)]"
            >
              Next →
            </button>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style is:global>
  /* Reveal styles engage ONLY when JS has added .nv-anim to <html> — crawlers
     and no-JS users always get fully visible content. */
  html.nv-anim .nv-anim-item {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
  }
  html.nv-anim .nv-anim-item.is-in {
    opacity: 1;
    transform: none;
  }
  /* Stagger the cards slightly by grid position. */
  html.nv-anim .nv-threat:nth-child(2) {
    transition-delay: 80ms;
  }
  html.nv-anim .nv-threat:nth-child(3) {
    transition-delay: 160ms;
  }
  html.nv-anim .nv-threat:nth-child(5) {
    transition-delay: 80ms;
  }
  html.nv-anim .nv-threat:nth-child(6) {
    transition-delay: 160ms;
  }
  @media (prefers-reduced-motion: reduce) {
    html.nv-anim .nv-anim-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  /* Hover: light highlight. Click: full spotlight — the chosen card is framed
     in gold with a warm glow, its glyph takes one bow, siblings step back. */
  .nv-threat.is-hot {
    border-color: var(--color-gold-400);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }
  .nv-threat.is-spot {
    border-color: var(--color-gold-400);
    box-shadow:
      0 0 0 2px var(--color-gold-400),
      0 18px 44px rgb(201 162 108 / 0.32);
    transform: translateY(-2px);
  }
  /* Both selectors: the second out-specifies the reveal rule's opacity:1. */
  .nv-threat.is-dim,
  html.nv-anim .nv-threat.is-in.is-dim {
    opacity: 0.45;
    filter: saturate(0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nv-threat.is-spot .nv-glyph {
      animation: nv-bow 0.6s ease;
    }
  }
  @keyframes nv-bow {
    0%,
    100% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.35);
    }
  }
  .nv-hotspot.is-live {
    background: var(--color-navy-950);
    color: var(--color-gold-300);
  }
  .nv-hotspot::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 1px solid var(--color-gold-400);
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nv-hotspot::after {
      animation: nv-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes nv-pulse {
    0% {
      transform: scale(0.8);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  // Progressive enhancement only — see the SEO contract in the frontmatter.
  document.documentElement.classList.add("nv-anim");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const startCount = (el: HTMLElement) => {
    const raw = el.dataset.countup ?? "";
    const target = parseFloat(raw);
    if (!Number.isFinite(target) || reduced) return;
    const decimals = (raw.split(".")[1] || "").length;
    const t0 = performance.now();
    const dur = 1300;
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = (target * eased).toFixed(decimals);
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-in");
        e.target.querySelectorAll<HTMLElement>("[data-countup]").forEach(startCount);
        io.unobserve(e.target);
      }
    },
    { threshold: 0.25 },
  );
  document.querySelectorAll(".nv-anim-item").forEach((el) => io.observe(el));

  // ── Spotlight engine: one card takes the stage, the rest step back ──────
  const cards = [...document.querySelectorAll<HTMLElement>(".nv-threat")];
  let spotTimer: ReturnType<typeof setTimeout> | undefined;

  const clearSpot = () => {
    clearTimeout(spotTimer);
    cards.forEach((c) => c.classList.remove("is-spot", "is-dim"));
    document.querySelectorAll(".nv-hotspot.is-live").forEach((h) => h.classList.remove("is-live"));
  };

  const spotlight = (card: HTMLElement) => {
    clearSpot();
    cards.forEach((c) => c.classList.add(c === card ? "is-spot" : "is-dim"));
    document.querySelector(`[data-hotspot="${card.id}"]`)?.classList.add("is-live");
    card.scrollIntoView({
      behavior: reduced ? "auto" : "smooth",
      block: "center",
      inline: "center",
    });
    card.focus({ preventScroll: true });
    spotTimer = setTimeout(clearSpot, 3200);
  };

  for (const b of document.querySelectorAll<HTMLElement>("[data-hotspot]")) {
    const card = document.getElementById(b.dataset.hotspot ?? "");
    if (!card) continue;
    const on = () => card.classList.add("is-hot");
    const off = () => card.classList.remove("is-hot");
    b.addEventListener("mouseenter", on);
    b.addEventListener("mouseleave", off);
    b.addEventListener("focus", on);
    b.addEventListener("blur", off);
    b.addEventListener("click", () => {
      off();
      spotlight(card);
    });
  }

  // Prev/Next on each card moves the spotlight to its neighbor.
  for (const b of document.querySelectorAll<HTMLElement>("[data-goto]")) {
    b.addEventListener("click", () => {
      const card = document.getElementById(b.dataset.goto ?? "");
      if (card) spotlight(card);
    });
  }

  // "House diagram" hops back up (and clears the stage) so another marker
  // can be picked.
  for (const a of document.querySelectorAll<HTMLElement>("[data-to-diagram]")) {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      clearSpot();
      document
        .getElementById("roof-diagram")
        ?.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
    });
  }
</script>
