---
/**
 * Jump-link table of contents for long-form (2,000+ word) pages. Pass the
 * headings in page order; each `id` must match an element id on the page
 * (section headings get their ids from `headingId()` in ~/lib/headings.ts so
 * the TOC and the headings can never drift apart).
 */
interface Props {
  heading?: string;
  items: { id: string; label: string }[];
}
const { heading = "On this page", items } = Astro.props;
---

{
  items.length > 1 && (
    <nav
      aria-label="Table of contents"
      class="rounded-[var(--radius-card)] border border-[color:var(--color-navy-100)] bg-white p-5"
    >
      <p class="text-xs font-semibold tracking-[0.18em] text-[color:var(--color-gold-600)] uppercase">
        {heading}
      </p>
      <ol class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
        {items.map((item) => (
          <li>
            <a
              class="text-[color:var(--color-navy-700,#1f356b)] hover:underline"
              href={`#${item.id}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
