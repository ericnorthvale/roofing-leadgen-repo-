---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  /** "dark" renders light text for photo/navy header bands. */
  variant?: "light" | "dark";
}
const { items, variant = "light" } = Astro.props;

const base = (Astro.site?.toString() ?? "https://northvaleroofing.com").replace(/\/+$/, "");

// Per schema.org/Google, `item` may be omitted for the current page (last crumb);
// emitting `item: undefined` fails Rich Results validation. Relative hrefs are
// made absolute — Google requires full URLs here.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: c.href.startsWith("http") ? c.href : `${base}${c.href}` } : {}),
  })),
};
---

<nav
  aria-label="Breadcrumbs"
  class:list={[
    "text-sm",
    variant === "dark"
      ? "text-[color:var(--color-navy-100)]/80 [&_a]:text-[color:var(--color-navy-100)] [&_a:hover]:text-[color:var(--color-gold-300)]"
      : "text-[color:var(--color-ink-500)]",
  ]}
>
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {c.href && i < items.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
