---
/**
 * Responsive photo gallery — renders real job photos via the RoofImage wrapper
 * so alt text is always present. Renders nothing when there are no photos.
 *
 * DELIBERATELY NO VISIBLE CAPTIONS (owner, 2026-11). Each photo carries a
 * unique title, description and keywords, but those exist for Google Images,
 * not for the person on the page — they ride in the `ImageGallery` /
 * `ImageObject` structured data the caller emits (see `galleryImagesJsonLd` in
 * src/lib/seo.ts), which is what image search actually indexes. The grid stays
 * a grid of photographs.
 *
 * No `title` attribute either: it renders as a hover tooltip, so it is
 * visitor-facing by definition, and Google does not use it for image ranking.
 * It would be visible text with no SEO return.
 */
import RoofImage from "@components/RoofImage.astro";

export interface GalleryPhoto {
  url: string;
  alt: string;
}
interface Props {
  photos: GalleryPhoto[];
  heading?: string;
}
const { photos, heading = "Recent work" } = Astro.props;
---

{
  photos.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-3xl">{heading}</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
        {photos.map((p) => (
          <RoofImage
            src={p.url}
            alt={p.alt}
            class="aspect-square w-full rounded-[var(--radius-card)] object-cover"
          />
        ))}
      </div>
    </section>
  )
}
