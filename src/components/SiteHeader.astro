---
import { BRAND } from "~/lib/brand";
import { telHref, formatPhoneDisplay } from "~/lib/phone";
import CTAButton from "@components/CTAButton.astro";

const phone = formatPhoneDisplay(BRAND.phoneE164);

const navLinks = [
  { href: "/services", label: "Services" },
  { href: "/roof-design-center", label: "Design Center" },
  { href: "/the-woodlands", label: "The Woodlands" },
  { href: "/storm-response", label: "Storm Response" },
  { href: "/reviews", label: "Reviews" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
];
---

<header class="relative border-b border-white/10 bg-[color:var(--color-navy-950)]">
  <div class="nv-bar mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4 sm:gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${BRAND.name} — home`}>
      <img
        src="/brand/logo-light.svg"
        alt=""
        class="nv-logo h-10 w-auto sm:h-11"
        loading="eager"
        decoding="async"
      />
    </a>

    {
      /* Full nav from lg up, on a single line at every width: link size and
        spacing scale fluidly with the viewport (see .nv-nav below) so the row
        never wraps, and the hamburger takes over below lg. */
    }
    <nav class="nv-nav hidden items-center whitespace-nowrap lg:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-medium text-[color:var(--color-navy-100)] no-underline transition-colors hover:text-[color:var(--color-gold-300)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      {
        /* Phone + CTA stay visible from md up — on tablets they sit next to the
          hamburger. Below md the sticky Call/Text bar carries conversion. */
      }
      <div class="hidden items-center gap-3 md:flex">
        <a
          href={telHref(BRAND.phoneE164)}
          data-cta-phone
          class="nv-phone font-semibold whitespace-nowrap text-white no-underline hover:text-[color:var(--color-gold-300)]"
        >
          {phone}
        </a>
        <CTAButton href="/contact" label="Book inspection" ctaId="header-book" />
      </div>

      {/* Mobile/tablet menu — native <details> disclosure, no JS, keyboard + SR accessible. */}
      <details class="nv-menu lg:hidden">
        <summary
          class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-[var(--radius-btn)] border border-white/25 text-white"
          aria-label="Open menu"
        >
          <svg
            class="nv-menu-open h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="nv-menu-close h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <nav
          class="absolute top-full right-0 left-0 z-50 border-b border-white/10 bg-[color:var(--color-navy-950)] shadow-[var(--shadow-card)]"
          aria-label="Mobile"
        >
          <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="flex min-h-12 items-center border-b border-white/5 text-base font-medium text-[color:var(--color-navy-100)] no-underline hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={telHref(BRAND.phoneE164)}
                data-cta-phone
                class="flex min-h-12 items-center font-semibold text-[color:var(--color-gold-300)] no-underline"
              >
                Call {phone}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Fluid one-line nav: between the lg breakpoint (1024px) and the max-w-6xl
     container cap, link text and gaps scale with the viewport so the full row
     (logo + 7 links + phone + CTA) always fits on a single line. */
  .nv-nav {
    gap: clamp(8px, 1.4vw, 16px);
  }
  .nv-nav a {
    font-size: clamp(11.5px, 1.1vw, 14px);
  }
  .nv-phone {
    font-size: clamp(12px, 1.05vw, 14px);
  }
  /* When the full nav row is visible, the logo and the gaps between the three
     groups scale down too, so the row clears the narrowest one-line width. */
  @media (min-width: 1024px) {
    .nv-logo {
      height: clamp(37px, 3.5vw, 44px);
    }
    .nv-bar {
      gap: clamp(12px, 1.8vw, 24px);
    }
  }

  /* Hide the default disclosure triangle and swap the open/close icons. */
  .nv-menu > summary {
    list-style: none;
  }
  .nv-menu > summary::-webkit-details-marker {
    display: none;
  }
  .nv-menu > summary .nv-menu-close {
    display: none;
  }
  .nv-menu[open] > summary .nv-menu-open {
    display: none;
  }
  .nv-menu[open] > summary .nv-menu-close {
    display: block;
  }
</style>
