---
import { getSiteReviews } from "~/lib/reviews";

const published = (await getSiteReviews()).slice(0, 3);
---

{
  /* Renders nothing until real reviews exist (owner request 2026-08-01) —
    the whole section returns automatically with the first review. */
}
{
  published.length > 0 && (
    <section class="bg-[color:var(--color-surface-ivory)]">
      <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
        <h2 class="text-3xl md:text-4xl">What our Woodlands + Spring neighbors say</h2>
        <div class="rule-gold mt-5" aria-hidden="true" />
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {published.map((r) => (
            <article class="rounded-[var(--radius-card)] border border-t-2 border-[color:var(--color-navy-100)] border-t-[color:var(--color-gold-400)] bg-white p-7">
              <p class="text-sm leading-relaxed">{r.text}</p>
              <p class="mt-5 text-sm font-semibold text-[color:var(--color-navy-900)]">
                {r.author}
              </p>
              <p class="mt-0.5 text-xs tracking-wide text-[color:var(--color-ink-500)] uppercase">
                {r.source} · {r.relativeTime}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
