---
/**
 * Paired before/after band — the single most persuasive roofing visual. Renders
 * two ImagePlaceholder slots today; pass `beforeSrc` / `afterSrc` once real
 * matched photos exist (same project, same angle). No layout shift on swap.
 */
import ImagePlaceholder from "@components/ImagePlaceholder.astro";

interface Props {
  heading?: string;
  intro?: string;
  beforeLabel?: string;
  afterLabel?: string;
  beforeAlt?: string;
  afterAlt?: string;
  beforeSrc?: string;
  afterSrc?: string;
  /** Figcaption under each photo — override for e.g. "During" / "Completed". */
  beforeCaption?: string;
  afterCaption?: string;
  class?: string;
}
const {
  heading = "Before & after",
  intro,
  beforeLabel = "BEFORE: storm-damaged roof",
  afterLabel = "AFTER: completed IKO roof",
  beforeAlt = "Roof before Northvale Roofing replacement, showing storm damage",
  afterAlt = "Completed IKO roof after Northvale Roofing replacement",
  beforeSrc,
  afterSrc,
  beforeCaption = "Before",
  afterCaption = "After",
  class: className,
} = Astro.props;
---

{
  /* The whole band renders ONLY once both real matched photos exist — no
     placeholder boxes or stock stand-ins on live pages (owner request
     2026-07-30). Callers can keep the component wired; it stays invisible
     until `beforeSrc` + `afterSrc` are supplied. */
  beforeSrc && afterSrc && (
    <section class:list={["mx-auto max-w-6xl px-4 py-16", className]}>
      <h2 class="text-3xl md:text-4xl">{heading}</h2>
      <div class="rule-gold mt-5" aria-hidden="true" />
      {intro && <p class="mt-3 max-w-2xl text-[color:var(--color-ink-800)]">{intro}</p>}
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <figure>
          <ImagePlaceholder
            slot={beforeLabel}
            alt={beforeAlt}
            src={beforeSrc}
            ratio="4/3"
            tone="navy"
          />
          <figcaption class="mt-2.5 text-xs font-semibold tracking-[0.15em] text-[color:var(--color-ink-500)] uppercase">
            {beforeCaption}
          </figcaption>
        </figure>
        <figure>
          <ImagePlaceholder
            slot={afterLabel}
            alt={afterAlt}
            src={afterSrc}
            ratio="4/3"
            tone="gold"
          />
          <figcaption class="mt-2.5 text-xs font-semibold tracking-[0.15em] text-[color:var(--color-ink-500)] uppercase">
            {afterCaption}
          </figcaption>
        </figure>
      </div>
    </section>
  )
}
