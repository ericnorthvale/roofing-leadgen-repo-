---
import CTAButton from "@components/CTAButton.astro";
import PhoneCTAButton from "@components/PhoneCTAButton.astro";
import ImagePlaceholder from "@components/ImagePlaceholder.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  subhead: string;
  primaryCta: { href: string; label: string; ctaId?: string };
  secondaryCta?: { href: string; label: string; ctaId?: string };
  /**
   * Optional hero visual. When omitted, the hero is text-only (no LCP image).
   * Pass `src` once a real photo exists — preload it in BaseLayout at that point
   * (see TASKS_FOR_ERIC "preload the LCP image once a real hero exists").
   */
  image?: { slot: string; alt: string; src?: string; ratio?: string; demoKey?: string };
}
const { eyebrow, headline, subhead, primaryCta, secondaryCta, image } = Astro.props;
---

<section
  class="relative overflow-hidden border-b border-[color:var(--color-navy-100)] bg-[color:var(--color-surface-ivory)]"
>
  <div
    class:list={[
      "mx-auto max-w-6xl px-4 py-20 md:py-28",
      image && "md:grid md:grid-cols-[1.05fr_0.95fr] md:items-center md:gap-14",
    ]}
  >
    <div>
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <h1 class="max-w-3xl text-[2.5rem] leading-[1.06] md:text-6xl">{headline}</h1>
      <div class="rule-gold mt-7" aria-hidden="true"></div>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-700)]">
        {subhead}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <CTAButton
          href={primaryCta.href}
          label={primaryCta.label}
          ctaId={primaryCta.ctaId ?? "hero-primary"}
        />
        <PhoneCTAButton ctaId="hero-call" />
        {
          secondaryCta && (
            <CTAButton
              href={secondaryCta.href}
              label={secondaryCta.label}
              ctaId={secondaryCta.ctaId ?? "hero-secondary"}
              variant="ghost"
            />
          )
        }
      </div>
    </div>
    {
      image && (
        <div class="relative mt-12 md:mt-0">
          <div
            class="absolute -right-3 -bottom-3 hidden h-full w-full border border-[color:var(--color-gold-400)] md:block"
            aria-hidden="true"
          />
          <ImagePlaceholder
            slot={image.slot}
            alt={image.alt}
            src={image.src}
            demoKey={image.demoKey}
            ratio={image.ratio ?? "4/3"}
            priority={true}
            tone="mixed"
            class="relative shadow-[var(--shadow-card)]"
          />
        </div>
      )
    }
  </div>
</section>
